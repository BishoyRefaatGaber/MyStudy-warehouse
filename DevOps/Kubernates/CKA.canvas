		{"id":"ef3535f440c67624","type":"text","text":"podSelector","x":1558,"y":-320,"width":168,"height":50},
		{"id":"f6ea12f28b5de152","type":"text","text":"selectors","x":1314,"y":-270,"width":141,"height":50},
		{"id":"3e1d9a6c2e33b8de","type":"text","text":"ipBlock\n","x":1556,"y":-245,"width":145,"height":50},
		{"id":"2785bade7280c248","type":"text","text":"Supports equality-based selectors","x":1117,"y":287,"width":330,"height":50},
		{"id":"787a967d79aa01ee","type":"text","text":"applied for","x":1314,"y":162,"width":156,"height":51},
		{"id":"5e89573cdee58432","type":"text","text":"Client","x":-736,"y":-476,"width":108,"height":50},
		{"id":"5d1d586e0a552808","type":"text","text":"mechanism for isolating groups of resources within a single cluster.","x":-1733,"y":-392,"width":574,"height":61},
		{"id":"3cc5ba4ece639f9e","type":"text","text":"namespace","x":-1083,"y":-350,"width":153,"height":50},
		{"id":"29432785d3ccfb02","type":"text","text":"Initial namespaces","x":-1371,"y":-306,"width":212,"height":50},
		{"id":"f0755e07062972f0","type":"text","text":"default","x":-1577,"y":-256,"width":125,"height":50},
		{"id":"a65444b418084f44","type":"text","text":"kube-system","x":-1629,"y":-169,"width":177,"height":50},
		{"id":"747a427b3531670d","type":"text","text":"kube-public ","x":-1608,"y":-62,"width":156,"height":50},
		{"id":"b4290171c3e0d119","type":"text","text":"namespaceSelector","x":1558,"y":-173,"width":234,"height":50},
		{"id":"761deb1b59a65885","type":"text","text":"Network policies are implemented by the network plugin for example calico.","x":1296,"y":-472,"width":641,"height":50},
		{"id":"30a4525ffa2fedba","type":"text","text":"Network Policies","x":937,"y":-359,"width":191,"height":50},
		{"id":"76b710186e35ae09","type":"text","text":"kubectl","x":-578,"y":-476,"width":134,"height":50},
		{"id":"8c97c5b1f9a08f6f","type":"text","text":"Kubernates","x":-677,"y":32,"width":160,"height":50},
		{"id":"4e90d6a689cee632","type":"text","text":"Secrets","x":-1537,"y":1362,"width":112,"height":50},
		{"id":"c5d5323db560be5b","type":"text","text":"Types","x":-1708,"y":1448,"width":86,"height":50},
		{"id":"3942baff79981778","type":"text","text":"Configurations","x":-1259,"y":1112,"width":250,"height":60},
		{"id":"4a01d1f15e11defb","type":"text","text":"ConfigMaps","x":-1569,"y":1142,"width":144,"height":50},
		{"id":"1eafe5c4e48a836e","type":"text","text":"effect","x":-1816,"y":3750,"width":110,"height":50},
		{"id":"ecfb7ef9a452a068","type":"text","text":"`NoExecute`","x":-1628,"y":3675,"width":162,"height":50},
		{"id":"d32f27e73f2f5646","type":"text","text":"value is optional","x":-1854,"y":3591,"width":186,"height":50},
		{"id":"7fbf582fed2bd263","type":"text","text":"Networking","x":417,"y":-96,"width":158,"height":50},
		{"id":"7c743fd6aa4ba4d5","type":"text","text":" SSH keys","x":-1979,"y":1625,"width":125,"height":50},
		{"id":"01303768670d8fd5","type":"text","text":" TLS certificates","x":-2043,"y":1707,"width":189,"height":50},
		{"id":"1f3a3dd3bfe2d5bf","type":"text","text":" Opaque secrets","x":-2029,"y":1387,"width":177,"height":50},
		{"id":"447f9390a4fec05d","type":"text","text":" Service account tokens","x":-2061,"y":1456,"width":208,"height":50},
		{"id":"bdba8e6f6a396188","type":"text","text":"```\ntolerations:\n- key: \"key1\"\n  operator: \"Equal\"\n  value: \"value1\"\n  effect: \"NoSchedule\"\n```","x":-2214,"y":4025,"width":285,"height":182},
		{"id":"e89046d4419907a3","type":"text","text":"operator","x":-1837,"y":4025,"width":131,"height":50},
		{"id":"c92844399ef86d57","type":"text","text":"`NoSchedule`","x":-1628,"y":3750,"width":162,"height":50},
		{"id":"bbcc83e4f714e410","type":"text","text":"`PreferNoSchedule","x":-1628,"y":3833,"width":210,"height":50},
		{"id":"c0675e0e5df229b6","type":"text","text":"`Equal`","x":-1628,"y":3999,"width":125,"height":50},
		{"id":"f4e33d343b462757","type":"text","text":"- useful while maintenance\n- move all pods in other nodes","x":-1418,"y":3668,"width":316,"height":64},
		{"id":"d6b233630639dc13","type":"text","text":"- `key` --> empty,  `operator` ---> must be `Exists` \nmatches all keys and values. Note that the `effect` still needs to be matched at the same time.\n\n- `effect` --> empty, \nmatches all effects with key `key1`.","x":-2214,"y":4257,"width":809,"height":128},
		{"id":"bdfd73e2aa4aef8e","type":"text","text":"`Exists`","x":-1628,"y":4066,"width":125,"height":50},
		{"id":"250861e13ca62b42","type":"text","text":"the values should be equal.","x":-1466,"y":3999,"width":276,"height":50},
		{"id":"7e5134110b428b64","type":"text","text":"- no `value` should be specified\n- match all pods with the key","x":-1444,"y":4058,"width":342,"height":66},
		{"id":"544120b079bd0271","type":"text","text":"Use Case","x":1796,"y":1961,"width":111,"height":50},
		{"id":"a6e7548b49d4a6d6","type":"text","text":" The volume is created when the Pod is assigned to a node.","x":1797,"y":1619,"width":466,"height":50},
		{"id":"ee05a62aad848749","type":"text","text":"All containers in the Pod can read and write the same files in the `emptyDir` volume, though that volume can be mounted at the same or different paths in each container.","x":1797,"y":1684,"width":688,"height":80},
		{"id":"da40a7d6309476cf","type":"text","text":"When a Pod is removed from a node for any reason, the data in the `emptyDir` is deleted permanently.","x":1797,"y":1779,"width":765,"height":50},
		{"id":"3a1a8a0478677a3e","type":"text","text":"- A container crashing does _not_ remove a Pod from a node. \n- The data in an `emptyDir` volume is safe across container crashes.","x":1797,"y":1843,"width":534,"height":67},
		{"id":"471a31b010f1454e","type":"text","text":"- matching is up to the IngressClass.\n- Will be Prefix or Exact","x":1862,"y":1506,"width":360,"height":69},
		{"id":"b57fd196baa187ee","type":"text","text":"ExternalName","x":1362,"y":814,"width":170,"height":50},
		{"id":"c815f4860bcb8e15","type":"text","text":"- lets you map traffic to different backends based on rules you define via the Kubernetes API.\n- Ingress exposes HTTP and HTTPS routes from outside the cluster to services within the cluster. \n- Traffic routing is controlled by rules defined on the Ingress resource.","x":1214,"y":967,"width":828,"height":104},
		{"id":"3feda789592c4351","type":"text","text":"Ingress","x":941,"y":1071,"width":126,"height":50},
		{"id":"52809377d9ebd9ef","type":"text","text":"hostname","x":1394,"y":1188,"width":146,"height":50},
		{"id":"57bbece7beccd186","type":"text","text":"path","x":1367,"y":1354,"width":100,"height":50},
		{"id":"f9768cb1afdb1724","type":"text","text":"Exact","x":1540,"y":1404,"width":116,"height":50},
		{"id":"f1e2abd121215b4c","type":"text","text":"- scratch space, such as for a disk-based merge sort\n- checkpointing a long computation for recovery from crashes\n- holding files that a content-manager container fetches while a webserver container serves the data","x":1961,"y":1932,"width":789,"height":108},
		{"id":"52d6ebdc31b1f717","type":"text","text":"Storage","x":964,"y":1806,"width":124,"height":50},
		{"id":"33d17853940dca8c","type":"text","text":"emptyDir","x":1532,"y":1724,"width":140,"height":50},
		{"id":"f984615005cbb373","type":"text","text":"ImplementationSpecific","x":1540,"y":1515,"width":257,"height":50},
		{"id":"13f1855c0c24ecb3","type":"text","text":"ClusterIP","x":1362,"y":466,"width":136,"height":50},
		{"id":"9406d32b985aa97d","type":"text","text":"- Exposes service on a static port (30000-32767) on each Node.\n- use the external node ip and the external node port to connect\n- **Use-case**: development testing, demo applications","x":1553,"y":564,"width":577,"height":95},
		{"id":"c34948467277d8f2","type":"text","text":"- Exposes service externally using cloud provider's load balancer\n- **Use-case**: Production applications requiring external access","x":1588,"y":687,"width":595,"height":79},
		{"id":"4886dfb024948a38","type":"text","text":"- default type\n- Accessible only within the cluster.\n- **use-case** : Internal microservices communication","x":1553,"y":440,"width":466,"height":101},
		{"id":"3633a81a5c72dd08","type":"text","text":"Service","x":900,"y":403,"width":123,"height":50},
		{"id":"b8524ed7b4693b95","type":"text","text":"Endpoint","x":1233,"y":378,"width":156,"height":50},
		{"id":"1bf7a5f2afe108c7","type":"text","text":"- Maps service to external DNS name\n- **Use-case**: External service integration","x":1617,"y":800,"width":392,"height":79},
		{"id":"e99c2d39b9c77ef7","type":"text","text":"can match based on wildcards","x":1598,"y":1188,"width":306,"height":50},
		{"id":"9d2957555d0d53e6","type":"text","text":"rules","x":1135,"y":1213,"width":107,"height":50},
		{"id":"1d93a5c38d8185a0","type":"text","text":"Prefix","x":1540,"y":1304,"width":116,"height":50},
		{"id":"0819a63b96153c63","type":"text","text":"types","x":1127,"y":547,"width":107,"height":50},
		{"id":"fbb165a7d58ce902","type":"text","text":"NodePort","x":1362,"y":586,"width":138,"height":50},
		{"id":"964701ac523e30da","type":"text","text":"LoadBalancer","x":1362,"y":701,"width":170,"height":50},
		{"id":"8e5eff47a5ca188c","type":"text","text":"iSCSI","x":2208,"y":3199,"width":88,"height":50},
		{"id":"fc191c8ef7c44eff","type":"text","text":"local","x":2208,"y":3278,"width":88,"height":50},
		{"id":"f465c02e608817ad","type":"text","text":"ReadWriteMany","x":2243,"y":3640,"width":165,"height":50},
		{"id":"dd73a9879dde45d6","type":"text","text":"abbr: RWX, Many nodes mount the volume as read/write.","x":2467,"y":3640,"width":456,"height":50},
		{"id":"5d3a46e16a431b58","type":"text","text":"## Access Mode Support\n\n| Volume Type | RWO | ROX | RWX |\n| ----------- | --- | --- | --- |\n| configMap   | Yes | No  | No  |\n| emptyDir    | Yes | No  | No  |\n| hostPath    | Yes | No  | No  |\n| iSCSI       | Yes | Yes | No  |\n| local       | Yes | No  | No  |\n| NFS         | Yes | Yes | Yes |","x":2243,"y":3749,"width":333,"height":317},
		{"id":"46e3e0f52a83aa7e","type":"text","text":"abbrv:  RWO,  A single node mounts the volume as read/write.","x":2467,"y":3448,"width":498,"height":50},
		{"id":"5fa921ae5cb17400","type":"text","text":"abbr: ROX, Many nodes mount the volume as read-only.","x":2467,"y":3540,"width":456,"height":50},
		{"id":"f74270b7ec5c2c77","type":"text","text":"emptyDir","x":2208,"y":3035,"width":125,"height":50},
		{"id":"830d88b80330bd25","type":"text","text":"Volumes","x":1982,"y":3121,"width":108,"height":50},
		{"id":"bfd154aa00337c47","type":"text","text":"hostPath","x":2208,"y":3121,"width":125,"height":50},
		{"id":"685dbcaf784cc81a","type":"text","text":"uses storage classes to create the persistent volumes on demand.","x":2363,"y":2792,"width":510,"height":50},
		{"id":"cb411ae8ad4c57d7","type":"text","text":"based on StorageClasses: the PVC must request a storage class and the administrator must have created and configured","x":2372,"y":2893,"width":907,"height":50},
		{"id":"ea4eeb505f505c51","type":"text","text":"requires the cluster administrator to create persistent volumes manually.","x":2339,"y":2707,"width":558,"height":50},
		{"id":"47e4fc6972c3511e","type":"text","text":"disk","x":2332,"y":3278,"width":80,"height":50},
		{"id":"a2cac5cb5ea74378","type":"text","text":"NFS","x":2208,"y":3358,"width":88,"height":50},
		{"id":"5649b1475b50658c","type":"text","text":"ReadWriteOnce","x":2243,"y":3448,"width":165,"height":50},
		{"id":"c9282e1f998b6f53","type":"text","text":"ReadOnlyMany","x":2243,"y":3540,"width":164,"height":50},
		{"id":"3a83263b572d1fd9","type":"text","text":"configMap","x":2208,"y":2954,"width":125,"height":50},
		{"id":"8bec333e47bb251c","type":"text","text":"PersistentVolume (pv)","x":1611,"y":2954,"width":235,"height":50},
		{"id":"fa66c3f7f728965f","type":"text","text":"Provisioning","x":1982,"y":2767,"width":138,"height":50},
		{"id":"b16e90247dc706b3","type":"text","text":"dynamic","x":2200,"y":2792,"width":106,"height":50},
		{"id":"eb6917c28cc96820","type":"text","text":"static","x":2200,"y":2707,"width":89,"height":50},
		{"id":"ce897ca48243567f","type":"text","text":"Ephemeral volume","x":1214,"y":2446,"width":205,"height":50},
		{"id":"669136a59ec457c9","type":"text","text":"hostPath","x":1532,"y":2396,"width":141,"height":50},
		{"id":"7565f95dfc91bfb2","type":"text","text":"The data stored in a ConfigMap can be referenced in a volume of type configMap","x":1728,"y":2473,"width":628,"height":50},
		{"id":"b2ae47758a6ff443","type":"text","text":"Persistent volumes","x":1219,"y":3253,"width":208,"height":50},
		{"id":"33799f03d9e79f3c","type":"text","text":"Access Modes","x":1982,"y":3590,"width":163,"height":50},
		{"id":"84c04b7003c205db","type":"text","text":"configMap","x":1532,"y":2473,"width":148,"height":50},
		{"id":"bfb06225389e2b50","type":"text","text":"Volume Modes","x":1982,"y":4279,"width":173,"height":50},
		{"id":"fe94ebfdb74520c7","type":"text","text":"Filesystem: default value","x":2243,"y":4169,"width":225,"height":50},
		{"id":"07bd6ddddd136f29","type":"text","text":"## Block Volume Support\n\n| Volume plug-in                    | Manually provisioned | Dynamically provisioned |\n| --------------------------------- | -------------------- | ----------------------- |\n| AWS EBS                           | Yes                  | Yes                     |\n| Azure disk                        | Yes                  | Yes                     |\n| Cinder                            | Yes                  | Yes                     |\n| Fibre channel                     | Yes                  | No                      |\n| GCP                               | Yes                  | Yes                     |\n| iSCSI                             | Yes                  | No                      |\n| local                             | Yes                  | No                      |\n| Red Hat OpenShift Data Foundation | Yes                  | Yes                     |\n| VMware vSphere                    | Yes                  | Yes                     |","x":2432,"y":4237,"width":508,"height":457},
		{"id":"b17acdfe7eee26fa","type":"text","text":"Block","x":2243,"y":4357,"width":85,"height":50},
		{"id":"6c2ad3494bcdd261","type":"text","text":"PersistentVolumeClaim (pvc)","x":1798,"y":4799,"width":290,"height":50},
		{"id":"e168c87cb9cfb138","type":"text","text":"The lifecycle of a PVC is not tied to a pod, but to a namespace.","x":2223,"y":4799,"width":488,"height":50},
		{"id":"365e189c5b69a5bf","type":"text","text":"Multiple pods from the same namespace but with potentially different workload controllers can connect to the same PVC.","x":2223,"y":4880,"width":904,"height":50},
		{"id":"a92543283d40f275","type":"text","text":"PV and PVC Lifecycles","x":1798,"y":5245,"width":204,"height":50},
		{"id":"f57ab595323975c4","type":"text","text":"Bound","x":2156,"y":5176,"width":100,"height":50},
		{"id":"64638d7034d984df","type":"text","text":"When a PV binds to a PVC, the PV cannot be bound to another PVC.","x":2223,"y":4962,"width":529,"height":50},
		{"id":"084ed772910d921a","type":"text","text":"Available","x":2156,"y":5105,"width":110,"height":50},
		{"id":"f268261007d35f84","type":"text","text":"In Use","x":2156,"y":5245,"width":97,"height":50},
		{"id":"74b5915eaeafae4e","type":"text","text":"Released","x":2156,"y":5314,"width":110,"height":50},
		{"id":"cc1add55e2f67752","type":"text","text":"Reclaimed","x":2156,"y":5380,"width":125,"height":50},
		{"id":"6742f436d86bcbbd","type":"text","text":"A PV that is bound to a PVC is also bound to the same namespace as the PVC, and no other PVC can use it.","x":2317,"y":5176,"width":802,"height":50},
		{"id":"5738e14152f5c279","type":"text","text":"After a PV is created, it becomes available for any PVC to use in the cluster in any namespace.","x":2317,"y":5105,"width":769,"height":50},
		{"id":"164ac5f68073a01a","type":"text","text":"After the developer deletes the PVC that is bound to a PV, the PV is released, and the storage that the PV used can be reclaimed.","x":2317,"y":5314,"width":955,"height":50},
		{"id":"409f207b29f232e7","type":"text","text":"The reclaim policy of a persistent volume tells the cluster what to do with the volume after it is released.","x":2338,"y":5380,"width":781,"height":50},
		{"id":"8c82e3a12a181359","type":"text","text":"pod is actively mounting the PVC. This is where _Storage Object in Use Protection_ kicks in: even if you try to delete the PVC or the PV at this stage, the deletion is deferred until the pod stops using it — preventing data loss.","x":2317,"y":5236,"width":856,"height":68},
		{"id":"eec39f56ec961961","type":"text","text":"determines what happens to the data on a PVC after the PVC is deleted.","x":2382,"y":5455,"width":568,"height":50},
		{"id":"840a4f0435e4d75b","type":"text","text":"Reclaim Policy","x":2156,"y":5455,"width":161,"height":50},
		{"id":"df81360234af7fa7","type":"text","text":"Types","x":2382,"y":5664,"width":87,"height":50},
		{"id":"3ac0c9be2ca0382b","type":"text","text":"Retain","x":2561,"y":5614,"width":99,"height":50},
		{"id":"0cba7d4b0e429bb6","type":"text","text":"allows for manual reclamation of the resource.","x":2778,"y":5564,"width":382,"height":50},
		{"id":"648b9907f5994d56","type":"text","text":"### manual reclamation steps\n- Delete the PersistentVolume.\n- Manually clean up the data on the associated storage asset.\n- Manually delete the associated storage asset.","x":2778,"y":5635,"width":493,"height":157},
		{"id":"a2dcce5ca5f34c6c","type":"text","text":"#### Delete","x":2561,"y":5824,"width":109,"height":50},
		{"id":"baa93ca381846c6c","type":"text","text":"deletion removes both the PersistentVolume object from Kubernetes, as well as the associated storage asset in the external infrastructure.","x":2778,"y":5804,"width":1029,"height":50},
		{"id":"5b823e6573b2b47c","type":"text","text":"#### Recycle","x":2561,"y":5964,"width":125,"height":50},
		{"id":"208221eb010200ca","type":"text","text":"deprecated","x":2778,"y":5939,"width":148,"height":50},
		{"id":"4f6dab7528faea92","type":"text","text":"Volumes that were dynamically provisioned inherit the reclaim policy of their StorageClass, which defaults to `Delete`.","x":2778,"y":5874,"width":890,"height":50},
		{"id":"66fafe35430c8f3f","type":"text","text":"performs a basic scrub (rm -rf \\/thevolume\\/) on the volume and makes it available again for a new claim.","x":2778,"y":6014,"width":786,"height":50},
		{"id":"3d86dce6794eba6e","type":"text","text":"Mode","x":2360,"y":6602,"width":97,"height":50},
		{"id":"a05ec8248dc30614","type":"text","text":"PV bound","x":2644,"y":6656,"width":125,"height":50},
		{"id":"206c84a926dea202","type":"text","text":"Developer","x":2270,"y":6389,"width":143,"height":50},
		{"id":"bd8ab904aa5b903c","type":"text","text":"PV released","x":2630,"y":6389,"width":153,"height":50},
		{"id":"ab8acbb0c8c9fa21","type":"text","text":"PV reclaimed","x":3046,"y":6389,"width":153,"height":50},
		{"id":"71a0ea5fdc967c8c","type":"text","text":"In use","x":2644,"y":6488,"width":125,"height":50},
		{"id":"ed0b2c014c512664","type":"text","text":"operators","x":859,"y":-2081,"width":145,"height":50},
		{"id":"02891c2d63c0641b","type":"text","text":"In","x":1087,"y":-2106,"width":84,"height":50},
		{"id":"6a85265c2ce28205","type":"text","text":"NotIn","x":1087,"y":-2041,"width":108,"height":50},
		{"id":"a692d445acc2c254","type":"text","text":"The label value is present in the supplied set of strings","x":1234,"y":-2106,"width":502,"height":50},
		{"id":"f37fa9ca26005228","type":"text","text":"Storage Classes","x":1376,"y":6993,"width":177,"height":50},
		{"id":"c31fa814327ae36a","type":"text","text":"a way to describe types of storage for the cluster and to provision dynamic storage on demand.","x":1682,"y":6913,"width":720,"height":50},
		{"id":"3cbaaf55b8e030bf","type":"text","text":"Admin or\nStorage Class","x":3057,"y":6651,"width":142,"height":60},
		{"id":"cce60cc1b998076b","type":"text","text":"Class","x":2235,"y":6678,"width":125,"height":50},
		{"id":"877e75943423134c","type":"text","text":"Size","x":2235,"y":6602,"width":97,"height":50},
		{"id":"cc10a0f05f99c90a","type":"text","text":"PV available","x":2837,"y":6656,"width":150,"height":50},
		{"id":"8c38125d8f0e5154","type":"text","text":"Recreate","x":1105,"y":-1197,"width":122,"height":50},
		{"id":"413bb4c4f69c87cc","type":"text","text":"All existing Pods are killed before new ones are created","x":1286,"y":-1197,"width":440,"height":50},
		{"id":"84570a6d6a8c356b","type":"text","text":"Strategy","x":904,"y":-1172,"width":120,"height":50},
		{"id":"f345c7975a53809d","type":"text","text":"RollingUpdate","x":1105,"y":-1122,"width":153,"height":50},
		{"id":"b00b100f9f15ab5f","type":"text","text":"The Deployment updates Pods in a rolling update fashion (gradually scale down the old ReplicaSets and scale up the new one)","x":1317,"y":-1122,"width":940,"height":50},
		{"id":"5b1b61267f49e7fe","type":"text","text":"ensures that all (or some) Nodes run a copy of a Pod. As nodes are added to the cluster, Pods are added to them.","x":906,"y":-912,"width":929,"height":50},
		{"id":"c33408b895d063c1","type":"text","text":"StatefulSet is the workload API object used to manage stateful applications.","x":899,"y":-833,"width":655,"height":50},
		{"id":"45156d032c82d18a","type":"text","text":"manages a set of Pods to run an application workload","x":904,"y":-1269,"width":471,"height":50},
		{"id":"4c25c97c55944033","type":"text","text":"Exists","x":1087,"y":-1966,"width":113,"height":50},
		{"id":"0b1b55b0c6bbdb6e","type":"text","text":"The label value is not contained in the supplied set of strings","x":1238,"y":-2041,"width":528,"height":50},
		{"id":"981a3ee6212cf828","type":"text","text":"maintain a stable set of replica Pods running at any given time.","x":904,"y":-1499,"width":538,"height":50},
		{"id":"1b1778428a9a8f1f","type":"text","text":"cons:\n- When you update the pod template the existing pods are not updated.\n- lack a rollback mechanism","x":904,"y":-1433,"width":626,"height":114},
		{"id":"4db9264afac2cfac","type":"text","text":"ReplicaSet","x":675,"y":-1434,"width":148,"height":50},
		{"id":"e6103b0502111ce5","type":"file","file":"MyStudy-warehouse/DevOps/Kubernates/Commands.md","x":667,"y":-2747,"width":784,"height":218},
		{"id":"60026d23d515d7f4","type":"text","text":"A label with this key exists on the object","x":1268,"y":-1966,"width":372,"height":50},
		{"id":"ed819f8eed5ba9b7","type":"text","text":"DoesNotExit","x":1087,"y":-1897,"width":178,"height":50},
		{"id":"f40f8bf1ed503839","type":"text","text":"No label with this key exists on the object","x":1345,"y":-1897,"width":389,"height":50},
		{"id":"3a05f4b17f3a8dc3","type":"text","text":"```\nselector:\n\tmatchLabels:\n\t\tkey1: value1\n\tmatchExpressions:\n\t\t- {key: key2, operator: [In|NotIn|Exits], values: [val1,val2,...]}\n```","x":707,"y":-1749,"width":678,"height":198},
		{"id":"cddbecd92515401b","type":"text","text":"```\nselector:\n  key1: value1\n```","x":707,"y":-1901,"width":231,"height":108},
		{"id":"d221a0fc540e0ab0","type":"text","text":"selectors","x":289,"y":-1778,"width":139,"height":50},
		{"id":"30333873d15c53a2","type":"text","text":"Node affinity","x":650,"y":-2258,"width":168,"height":50},
		{"id":"d610108e98f2cefa","type":"text","text":"nodeSelector","x":667,"y":-2414,"width":168,"height":50},
		{"id":"6e33f6778f9507a4","type":"text","text":"Types","x":875,"y":-2258,"width":112,"height":50},
		{"id":"a852f8760bcb9440","type":"text","text":"requiredDuringSchedulingIgnoredDuringExecution","x":1059,"y":-2301,"width":443,"height":50},
		{"id":"f4520ad45bb34036","type":"text","text":"preferredDuringSchedulingIgnoredDuringExecution","x":1059,"y":-2208,"width":480,"height":50},
		{"id":"585209af6750b36d","type":"text","text":"Assigning Pods to Nodes","x":332,"y":-2365,"width":262,"height":50},
		{"id":"d3bd9f387429de76","type":"text","text":"commands","x":358,"y":-2464,"width":147,"height":50},
		{"id":"e1c651a908e8e56b","type":"text","text":"page 344","x":1682,"y":6991,"width":250,"height":60},
		{"id":"780a8d6a4ecff6b9","type":"text","text":"indicates that PersistentVolumeClaims should not be provisioned and bound until the first Pod is created that references the PeristentVolumeClaim. \nThe volume provisioning and binding will occur during Pod scheduing.","x":2610,"y":7452,"width":1092,"height":70},
		{"id":"78d7ee8758efcb1d","type":"text","text":"WaitForFirstConsumer","x":2329,"y":7427,"width":207,"height":50},
		{"id":"46ac540436c81a70","type":"text","text":"shows whether the storage class allow volume expand.","x":2329,"y":7539,"width":451,"height":50},
		{"id":"7acf725fac493d17","type":"text","text":"AllowVolumeExpansion","x":2040,"y":7539,"width":227,"height":50},
		{"id":"e5c2ea70c2e9e523","type":"text","text":"ReclaimPolicy","x":2040,"y":7238,"width":156,"height":50},
		{"id":"8465cc189cb58d94","type":"text","text":"- parameters holds the parameters for the provisioner that should create volumes of this storage class.\n- parameters: \n\t\ttype: io1 \n\t\tiopsPerGB: \"10\"","x":2262,"y":7012,"width":841,"height":123},
		{"id":"99cb04ef02381726","type":"text","text":"VolumeBindingMode","x":2040,"y":7315,"width":222,"height":50},
		{"id":"d92b217ab4d93b68","type":"text","text":"indicates how PersistentVolumeClaims should be provisioned and bound.","x":2329,"y":7265,"width":561,"height":50},
		{"id":"99106d3fbec5c95d","type":"text","text":"Immediate","x":2329,"y":7340,"width":143,"height":50},
		{"id":"961901272f8ed774","type":"text","text":"indicates that PersistentVolumeClaims should be immediately provisioned and bound. This is the default mode.","x":2560,"y":7335,"width":661,"height":60},
		{"id":"dc396c925692eaeb","type":"text","text":"identifies the source of the storage medium plug-in.","x":2267,"y":7161,"width":421,"height":50},
		{"id":"c69c4c67f6179488","type":"text","text":"Provisioners","x":2040,"y":7161,"width":156,"height":50},
		{"id":"eeaa3a31ce16f822","type":"text","text":"attributes","x":1682,"y":7113,"width":143,"height":50},
		{"id":"edb20f6a2e378234","type":"text","text":"Parameters","x":2040,"y":7048,"width":125,"height":50}
	],
