		{"id":"5d1d586e0a552808","type":"text","text":"mechanism for isolating groups of resources within a single cluster.","x":-1553,"y":-109,"width":574,"height":61},
		{"id":"29432785d3ccfb02","type":"text","text":"Initial namespaces","x":-1191,"y":-23,"width":212,"height":50},
