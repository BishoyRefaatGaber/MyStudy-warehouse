		{"id":"536c09e467fcae5f","type":"text","text":"Node leases allow the kubelet to send heartbeats so that the control plane can detect node failure.","x":-2394,"y":334,"width":827,"height":50},
		{"id":"d0878a29b697b7e4","type":"text","text":"kube-node-lease","x":-1491,"y":334,"width":219,"height":50},
		{"id":"af126f8a1143a220","type":"text","text":"The namespace for objects created by the Kubernetes system","x":-2060,"y":114,"width":554,"height":50},
		{"id":"aa3bee13e9225ce8","type":"text","text":"- This namespace is readable by _all_ clients (including those not authenticated).\n- This namespace is mostly reserved for cluster usage, in case that some resources should be visible and readable publicly throughout the whole cluster.","x":-2733,"y":206,"width":1245,"height":80},
		{"id":"db9a4e5474e37455","type":"text","text":"Used for resources with no specific namespace.","x":-1920,"y":27,"width":429,"height":50},
		{"id":"747a427b3531670d","type":"text","text":"kube-public ","x":-1428,"y":221,"width":156,"height":50},
