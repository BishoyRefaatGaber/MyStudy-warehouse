		{"id":"0e2c65e402b19931","type":"text","text":"kubectl","x":-1962,"y":-1032,"width":121,"height":50},
		{"id":"9c9428c41ade5edf","type":"text","text":"kubectl is supported within one minor version (older or newer) of kube-apiserver.","x":-2718,"y":-1032,"width":681,"height":50},
		{"id":"e7c479b288d7b8c6","type":"text","text":"kubelet must not be newer than kube-apiserver, and may be up to two minor versions older.","x":-2874,"y":-1256,"width":759,"height":50},
		{"id":"eb4576e18608faba","type":"text","text":" the newest and oldest kube-apiserver instances must be within one minor version.","x":-2809,"y":-1328,"width":694,"height":50},
		{"id":"cff64d3db281ed81","type":"text","text":"Must not be newer than the kube-apiserver.\nExpected to match the kube-apiserver minor version. \nCan be upto one minor version older","x":-2738,"y":-1163,"width":488,"height":105},
		{"id":"f09edc9b3424a100","type":"text","text":"kube-apiserver","x":-2032,"y":-1328,"width":183,"height":50},
