		{"id":"585209af6750b36d","type":"text","text":"Assigning Pods to Nodes","x":95,"y":-893,"width":262,"height":50},
		{"id":"45156d032c82d18a","type":"text","text":"manages a set of Pods to run an application workload","x":667,"y":203,"width":471,"height":50},
		{"id":"1b1778428a9a8f1f","type":"text","text":"cons:\n- When you update the pod template the existing pods are not updated.\n- lack a rollback mechanism","x":667,"y":39,"width":626,"height":114},
		{"id":"981a3ee6212cf828","type":"text","text":"maintain a stable set of replica Pods running at any given time.","x":667,"y":-27,"width":538,"height":50},
