		{"id":"761deb1b59a65885","type":"text","text":"Network policies are implemented by the network plugin for example calico.","x":1059,"y":1000,"width":641,"height":50},
		{"id":"abc61130bd5d7e82","type":"text","text":"IP blocks (cidr)","x":1318,"y":1536,"width":183,"height":50},
		{"id":"30a4525ffa2fedba","type":"text","text":"Network Policies","x":700,"y":1113,"width":191,"height":50},
		{"id":"f8be97daa0695bc6","type":"text","text":"Ingress","x":1328,"y":1375,"width":136,"height":50},
		{"id":"039fd0de4e914179","type":"text","text":"Egress","x":1328,"y":1446,"width":117,"height":50},
		{"id":"b4290171c3e0d119","type":"text","text":"namespaceSelector","x":1321,"y":1299,"width":234,"height":50},
		{"id":"7fbf582fed2bd263","type":"text","text":"Networking","x":180,"y":1376,"width":158,"height":50},
		{"id":"5b1b61267f49e7fe","type":"text","text":"ensures that all (or some) Nodes run a copy of a Pod. As nodes are added to the cluster, Pods are added to them.","x":669,"y":560,"width":929,"height":50},
		{"id":"c33408b895d063c1","type":"text","text":"StatefulSet is the workload API object used to manage stateful applications.","x":662,"y":639,"width":655,"height":50},
		{"id":"3b1151cb0d51df41","type":"text","text":"DaemonSet","x":440,"y":560,"width":157,"height":50},
		{"id":"d0d314f20d406713","type":"text","text":"A Job creates one or more Pods and will continue to retry execution of the Pods until a specified number of them successfully terminate","x":613,"y":716,"width":1115,"height":50},
		{"id":"b8337f756ba687ee","type":"text","text":"creates Jobs on a repeating schedule.","x":646,"y":794,"width":367,"height":50},
		{"id":"8e350d20c4147280","type":"text","text":"StatefulSet","x":440,"y":639,"width":150,"height":50},
		{"id":"a0dc6101b406b07c","type":"text","text":"Job","x":440,"y":716,"width":96,"height":50},
		{"id":"ef3535f440c67624","type":"text","text":"podSelector","x":1321,"y":1152,"width":168,"height":50},
		{"id":"f6ea12f28b5de152","type":"text","text":"selectors","x":1077,"y":1202,"width":141,"height":50},
		{"id":"3e1d9a6c2e33b8de","type":"text","text":"ipBlock\n","x":1319,"y":1227,"width":145,"height":50},
		{"id":"8c38125d8f0e5154","type":"text","text":"Recreate","x":868,"y":275,"width":122,"height":50},
		{"id":"f40f8bf1ed503839","type":"text","text":"No label with this key exists on the object","x":1108,"y":-425,"width":389,"height":50},
		{"id":"0b1b55b0c6bbdb6e","type":"text","text":"The label value is not contained in the supplied set of strings","x":1001,"y":-569,"width":528,"height":50},
		{"id":"60026d23d515d7f4","type":"text","text":"A label with this key exists on the object","x":1031,"y":-494,"width":372,"height":50},
		{"id":"a692d445acc2c254","type":"text","text":"The label value is present in the supplied set of strings","x":997,"y":-634,"width":502,"height":50},
		{"id":"84570a6d6a8c356b","type":"text","text":"Strategy","x":667,"y":300,"width":120,"height":50},
		{"id":"f345c7975a53809d","type":"text","text":"RollingUpdate","x":868,"y":350,"width":153,"height":50},
		{"id":"413bb4c4f69c87cc","type":"text","text":"All existing Pods are killed before new ones are created","x":1049,"y":275,"width":440,"height":50},
		{"id":"b00b100f9f15ab5f","type":"text","text":"The Deployment updates Pods in a rolling update fashion (gradually scale down the old ReplicaSets and scale up the new one)","x":1080,"y":350,"width":940,"height":50},
		{"id":"c26327c5d7b2cdce","type":"text","text":"CronJob","x":440,"y":794,"width":144,"height":50},
		{"id":"8e4f95878ca53eda","type":"text","text":"- Taints allow a node to repel a set of pods.\n- Tolerations allow the scheduler to schedule pods with matching taints.","x":1235,"y":4318,"width":639,"height":74},
		{"id":"12ebbf7bcc5f1fcc","type":"text","text":"```\nkubectl taint nodes node1 key1=value1:effect\n```","x":1235,"y":4442,"width":639,"height":78},
		{"id":"ecfb7ef9a452a068","type":"text","text":"`NoExecute`","x":1874,"y":4673,"width":162,"height":50},
		{"id":"f4e33d343b462757","type":"text","text":"- useful while maintenance\n- move all pods in other nodes","x":2084,"y":4666,"width":316,"height":64},
		{"id":"c92844399ef86d57","type":"text","text":"`NoSchedule`","x":1874,"y":4748,"width":162,"height":50},
		{"id":"bbcc83e4f714e410","type":"text","text":"`PreferNoSchedule","x":1874,"y":4831,"width":210,"height":50},
		{"id":"c0675e0e5df229b6","type":"text","text":"`Equal`","x":1874,"y":4997,"width":125,"height":50},
		{"id":"250861e13ca62b42","type":"text","text":"the values should be equal.","x":2036,"y":4997,"width":276,"height":50},
		{"id":"bdfd73e2aa4aef8e","type":"text","text":"`Exists`","x":1874,"y":5064,"width":125,"height":50},
		{"id":"7e5134110b428b64","type":"text","text":"- no `value` should be specified\n- match all pods with the key","x":2058,"y":5056,"width":342,"height":66},
		{"id":"13f1855c0c24ecb3","type":"text","text":"ClusterIP","x":1125,"y":1938,"width":136,"height":50},
		{"id":"db5f245014fc11e8","type":"text","text":"Service Account","x":1045,"y":3908,"width":190,"height":50},
		{"id":"fc7656d0820bb0c5","type":"text","text":"Security","x":789,"y":4020,"width":130,"height":50},
		{"id":"7eb3aab0f3e2e59d","type":"text","text":"Taint & Toleration","x":942,"y":4367,"width":198,"height":50},
		{"id":"5e11420bf9d94f4c","type":"text","text":"scheduling","x":685,"y":4417,"width":148,"height":50},
		{"id":"d32f27e73f2f5646","type":"text","text":"value is optional","x":1648,"y":4589,"width":186,"height":50},
		{"id":"1eafe5c4e48a836e","type":"text","text":"effect","x":1686,"y":4748,"width":110,"height":50},
		{"id":"bdba8e6f6a396188","type":"text","text":"```\ntolerations:\n- key: \"key1\"\n  operator: \"Equal\"\n  value: \"value1\"\n  effect: \"NoSchedule\"\n```","x":1288,"y":5023,"width":285,"height":182},
		{"id":"e89046d4419907a3","type":"text","text":"operator","x":1665,"y":5023,"width":131,"height":50},
		{"id":"d6b233630639dc13","type":"text","text":"- `key` --> empty,  `operator` ---> must be `Exists` \nmatches all keys and values. Note that the `effect` still needs to be matched at the same time.\n\n- `effect` --> empty, \nmatches all effects with key `key1`.","x":1288,"y":5255,"width":809,"height":128},
		{"id":"c815f4860bcb8e15","type":"text","text":"- lets you map traffic to different backends based on rules you define via the Kubernetes API.\n- Ingress exposes HTTP and HTTPS routes from outside the cluster to services within the cluster. \n- Traffic routing is controlled by rules defined on the Ingress resource.","x":977,"y":2439,"width":828,"height":104},
		{"id":"3feda789592c4351","type":"text","text":"Ingress","x":704,"y":2543,"width":126,"height":50},
		{"id":"964701ac523e30da","type":"text","text":"LoadBalancer","x":1125,"y":2173,"width":170,"height":50},
		{"id":"b57fd196baa187ee","type":"text","text":"ExternalName","x":1125,"y":2286,"width":170,"height":50},
		{"id":"c34948467277d8f2","type":"text","text":"- Exposes service externally using cloud provider's load balancer\n- **Use-case**: Production applications requiring external access","x":1351,"y":2159,"width":595,"height":79},
		{"id":"9406d32b985aa97d","type":"text","text":"- Exposes service on a static port (30000-32767) on each Node.\n- use the external node ip and the external node port to connect\n- **Use-case**: development testing, demo applications","x":1316,"y":2036,"width":577,"height":95},
		{"id":"1bf7a5f2afe108c7","type":"text","text":"- Maps service to external DNS name\n- **Use-case**: External service integration","x":1380,"y":2272,"width":392,"height":79},
		{"id":"ce897ca48243567f","type":"text","text":"Ephemeral volume","x":977,"y":3226,"width":205,"height":50},
		{"id":"fbb165a7d58ce902","type":"text","text":"NodePort","x":1125,"y":2058,"width":138,"height":50},
		{"id":"4886dfb024948a38","type":"text","text":"- default type\n- Accessible only within the cluster.\n- **use-case** : Internal microservices communication","x":1316,"y":1912,"width":466,"height":101},
		{"id":"52809377d9ebd9ef","type":"text","text":"hostname","x":1157,"y":2660,"width":146,"height":50},
		{"id":"33d17853940dca8c","type":"text","text":"emptyDir","x":1295,"y":3105,"width":140,"height":50},
		{"id":"669136a59ec457c9","type":"text","text":"hostPath","x":1295,"y":3176,"width":141,"height":50},
		{"id":"471a31b010f1454e","type":"text","text":"- matching is up to the IngressClass.\n- Will be Prefix or Exact","x":1625,"y":2978,"width":360,"height":69},
		{"id":"f984615005cbb373","type":"text","text":"ImplementationSpecific","x":1303,"y":2987,"width":257,"height":50},
		{"id":"84c04b7003c205db","type":"text","text":"configMap","x":1295,"y":3253,"width":148,"height":50},
		{"id":"52d6ebdc31b1f717","type":"text","text":"Storage","x":727,"y":3278,"width":124,"height":50},
		{"id":"8bec333e47bb251c","type":"text","text":"PersistentVolume (pv)","x":1290,"y":3358,"width":235,"height":50},
		{"id":"6c2ad3494bcdd261","type":"text","text":"PersistentVolumeClaim (pvc)","x":1290,"y":3433,"width":290,"height":50},
		{"id":"b2ae47758a6ff443","type":"text","text":"Persistent volumes","x":974,"y":3408,"width":208,"height":50},
		{"id":"e99c2d39b9c77ef7","type":"text","text":"can match based on wildcards","x":1361,"y":2660,"width":306,"height":50},
		{"id":"9d2957555d0d53e6","type":"text","text":"rules","x":898,"y":2685,"width":107,"height":50},
		{"id":"1d93a5c38d8185a0","type":"text","text":"Prefix","x":1303,"y":2776,"width":116,"height":50},
		{"id":"f9768cb1afdb1724","type":"text","text":"Exact","x":1303,"y":2876,"width":116,"height":50},
		{"id":"57bbece7beccd186","type":"text","text":"path","x":1130,"y":2826,"width":100,"height":50},
		{"id":"0819a63b96153c63","type":"text","text":"types","x":890,"y":2019,"width":107,"height":50},
		{"id":"3633a81a5c72dd08","type":"text","text":"Service","x":663,"y":1875,"width":123,"height":50},
		{"id":"b8524ed7b4693b95","type":"text","text":"Endpoint","x":996,"y":1850,"width":156,"height":50},
		{"id":"2785bade7280c248","type":"text","text":"Supports equality-based selectors","x":880,"y":1759,"width":330,"height":50},
