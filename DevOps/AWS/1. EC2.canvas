		{"id":"ce95a265d4d4ce4e","type":"text","text":"bound to a specific availability zone","x":-351,"y":-486,"width":338,"height":50,"color":"3"},
		{"id":"f3fabd81f00f43b2","type":"text","text":"a backup (snapshot) of your EBS volume at a point in time","x":-93,"y":-403,"width":503,"height":50,"color":"3"},
		{"id":"9c6953733c29c3ce","type":"text","text":"EBS Snapshots","x":-351,"y":-378,"width":185,"height":50,"color":"3"},
		{"id":"38c33ddcb3b8785a","type":"text","text":"A physical server with EC2 instance capacity fully dedicated to your use","x":-108,"y":-3008,"width":612,"height":50,"color":"3"},
		{"id":"d13e9b9df1d6e80a","type":"text","text":"Dedicated Hosts","x":-522,"y":-2958,"width":250,"height":60,"color":"3"},
		{"id":"5dac6df1db7ac071","type":"text","text":" Allows you address compliance requirements and use your existing server-bound software licenses (per-socket, per-core, pe—VM software licenses)","x":-108,"y":-2948,"width":1215,"height":50,"color":"3"},
		{"id":"29bbf484d540ff69","type":"text","text":" Purchasing Options:\n• On-demand \n• Reserved","x":-108,"y":-2884,"width":228,"height":104,"color":"3"},
		{"id":"832658502664f38f","type":"text","text":"The most expensive option","x":-108,"y":-2769,"width":274,"height":50,"color":"3"},
		{"id":"04ded5197d9c3683","type":"text","text":"# EC2","x":-2272,"y":-2744,"width":123,"height":64,"color":"3"},
		{"id":"f40369888a0c90ee","type":"text","text":"Dedicated Instances","x":-522,"y":-2587,"width":250,"height":60,"color":"3"},
		{"id":"c41461b7d591970a","type":"text","text":"Capacity Reservations","x":-522,"y":-2496,"width":250,"height":60,"color":"3"},
		{"id":"9e0d0057a0b61a13","type":"text","text":"Instances run on hardware that’s dedicated to you","x":-164,"y":-2582,"width":449,"height":50,"color":"3"},
		{"id":"5b291edb2718ccdb","type":"text","text":"clusters instances into a low-latency group in a single Availability Zone","x":-110,"y":-2058,"width":604,"height":50,"color":"3"},
		{"id":"c30b70c2d26c5bf8","type":"text","text":" If the AZ fails, all instances fails at the same time","x":-110,"y":-1992,"width":452,"height":50,"color":"3"},
		{"id":"96af05acf3d8fe5c","type":"text","text":"Use case:\n• Big Data job that needs to complete fast\n• Application that needs extremely low latency and high network throughput","x":-110,"y":-1928,"width":683,"height":109,"color":"3"},
		{"id":"cf076ff85967627e","type":"text","text":"spreads instances across underlying hardware (max 7 instances per group per AZ)","x":-110,"y":-1778,"width":697,"height":50,"color":"3"},
		{"id":"b5b1b2434bef4131","type":"text","text":"Pros:\n• Can span across Availability Zones (AZ)\n• Reduced risk is simultaneous failure\n• EC2 Instances are on different physical hardware","x":-110,"y":-1710,"width":453,"height":118,"color":"3"},
		{"id":"4c31a616e2e3b233","type":"text","text":"Cons:\n• Limited to 7 instances per AZ per placement group","x":-110,"y":-1574,"width":472,"height":70,"color":"3"},
		{"id":"174ddd8f281fdc30","type":"text","text":"Use case:\n• Application that needs to maximize high availability.\n• Critical Applications where each instance must be isolated from failure from each other.","x":-110,"y":-1486,"width":749,"height":93,"color":"3"},
		{"id":"aeb36e713b9a3281","type":"text","text":"spreads instances across many different partitions (which rely on different sets of racks) within an AZ. Scales to 100s of EC2 instances per group (Hadoop, Cassandra, Kafka)","x":-120,"y":-1312,"width":1385,"height":50,"color":"3"},
		{"id":"5994aae029aca4fc","type":"text","text":"Up to 7 partitions per AZ","x":-120,"y":-1250,"width":264,"height":50,"color":"3"},
		{"id":"fd1385ebd6c9aaa2","type":"text","text":"Elastic Network Interfaces (ENI)","x":-664,"y":-859,"width":314,"height":50,"color":"3"},
		{"id":"89394c9c115da6f9","type":"text","text":"EC2 Hibernate","x":-664,"y":-730,"width":176,"height":50,"color":"3"},
		{"id":"b88f0bbc6e15cfab","type":"text","text":"Root Volume – must be EBS, encrypted, not instance store, and large","x":-416,"y":-755,"width":591,"height":50,"color":"3"},
		{"id":"e1dc79df518b2f19","type":"text","text":"An instance can NOT be hibernated more than 60 days","x":-416,"y":-687,"width":487,"height":50,"color":"3"},
		{"id":"f00f2a3a6271ae75","type":"text","text":"Partition","x":-346,"y":-1184,"width":130,"height":50,"color":"3"},
		{"id":"350f48e0d7882011","type":"text","text":"Can span across multiple AZs in the same region","x":-120,"y":-1184,"width":437,"height":50,"color":"3"},
		{"id":"dd3f5ecf777ecce3","type":"text","text":"The instances in a partition do not share racks with the instances in the other partitions","x":-120,"y":-1117,"width":742,"height":50,"color":"3"},
		{"id":"6b7e8ae933de2f16","type":"text","text":" EC2 instances get access to the partition information as metadata","x":-120,"y":-1053,"width":572,"height":50,"color":"3"},
		{"id":"77d8e4bc326d3a8f","type":"text","text":"Use cases: HDFS, HBase, Cassandra, Kafka","x":-120,"y":-987,"width":399,"height":50,"color":"3"},
		{"id":"e5ed1f69d3ab02ad","type":"text","text":"Bound to a specific availability zone (AZ)","x":-251,"y":-859,"width":389,"height":50,"color":"3"},
		{"id":"123a2df96004285c","type":"text","text":"Associate","x":-999,"y":-2240,"width":151,"height":50,"color":"3"},
		{"id":"09318097ece6feaf","type":"text","text":"Elastic IP","x":-731,"y":-2320,"width":133,"height":50,"color":"3"},
		{"id":"a4e1108add12629d","type":"text","text":"Placement Groups","x":-664,"y":-2013,"width":209,"height":50,"color":"3"},
		{"id":"900b9b14d89c6dc5","type":"text","text":"Cluster","x":-349,"y":-1988,"width":130,"height":50,"color":"3"},
		{"id":"b07b7b335300f0c2","type":"text","text":"Spread","x":-344,"y":-1710,"width":125,"height":50,"color":"3"},
		{"id":"c9afac9dfe716386","type":"text","text":"fixed public IP for your instance","x":-491,"y":-2340,"width":308,"height":50,"color":"3"},
		{"id":"16d00e45a63c8645","type":"text","text":"You can only have 5 Elastic IP in your account","x":-491,"y":-2285,"width":413,"height":50,"color":"3"},
		{"id":"aa35e30531695ebc","type":"text","text":" try to avoid using Elastic IP:\n• They often reflect poor architectural decisions\n• Instead, use a random public IP and register a DNS name to it\n• Or, use a Load Balancer and don’t use a public IP","x":-491,"y":-2219,"width":563,"height":116,"color":"3"},
		{"id":"026f9878e98dcf00","type":"text","text":"Usage beyond EC2 Savings Plans is billed at the On-Demand price","x":-91,"y":-3760,"width":589,"height":60,"color":"3"},
		{"id":"b4205c8fcb52ac5e","type":"text","text":"Locked to a specific instance family & AWS region (e.g., M5 in us-east-1)","x":-91,"y":-3673,"width":627,"height":60,"color":"3"},
		{"id":"fbc02f74ebd21283","type":"text","text":" Flexible across:\n• Instance Size (e.g., m5.xlarge, m5.2xlarge)\n• OS (e.g., Linux, Windows)\n• Tenancy (Host, Dedicated, Default)","x":-91,"y":-3600,"width":421,"height":136,"color":"3"},
		{"id":"8ec3a91604f06f14","type":"text","text":"The MOST cost-efficient instances in AWS","x":-91,"y":-3392,"width":393,"height":50,"color":"3"},
		{"id":"66d4c5039b525430","type":"text","text":" Useful for workloads that are resilient to failure\n• Batch jobs\n• Data analysis\n• Image processing\n• Any distributed workloads\n• Workloads with a flexible start and end time","x":-91,"y":-3322,"width":434,"height":192,"color":"3"},
		{"id":"5725fd6d924df4b8","type":"text","text":" Not suitable for critical jobs or databases","x":-91,"y":-3106,"width":434,"height":50,"color":"3"},
		{"id":"5fa2a845ec847e3c","type":"text","text":"High Availability","x":-871,"y":4531,"width":211,"height":50,"color":"3"},
		{"id":"0b0d8549babfb0e8","type":"text","text":"Features","x":110,"y":4667,"width":130,"height":50,"color":"3"},
		{"id":"de2aee1c032fc91a","type":"text","text":"Cookie Names","x":924,"y":4640,"width":191,"height":50,"color":"3"},
		{"id":"a4e7d96ed74193de","type":"text","text":"Application-based Cookies","x":1273,"y":4581,"width":273,"height":50,"color":"3"},
		{"id":"6f9eaa51148d82f8","type":"text","text":"Duration-based Cookies","x":1273,"y":4713,"width":250,"height":50,"color":"3"},
		{"id":"b61f69782f00a4f6","type":"text","text":"ASG are free","x":-83,"y":5219,"width":168,"height":50,"color":"3"},
		{"id":"b20f37c46f4afc90","type":"text","text":"Launch Template","x":161,"y":5366,"width":201,"height":50,"color":"3"},
		{"id":"7160f0703f50dfc8","type":"text","text":" Attributes","x":-86,"y":5542,"width":141,"height":50,"color":"3"},
		{"id":"a2c0e959f251c52f","type":"text","text":"Auto Scaling Group","x":-454,"y":5741,"width":213,"height":50,"color":"3"},
		{"id":"149e6792ef91600c","type":"text","text":"Min Size / Max Size / Initial Capacity","x":161,"y":5440,"width":346,"height":50,"color":"3"},
		{"id":"271595b97fa7ee3e","type":"text","text":"Scaling Policies","x":161,"y":5614,"width":198,"height":50,"color":"3"},
		{"id":"8872c75d9b6c1587","type":"text","text":"Any custom metric (that you push using CloudWatch)","x":175,"y":6241,"width":477,"height":50,"color":"3"},
		{"id":"f8ab9d3ea9f9e214","type":"text","text":"scaling activity happens, you are in the cooldown period (default 300 seconds)","x":230,"y":6373,"width":669,"height":50,"color":"3"},
		{"id":"a0c6a58e9d3e6745","type":"text","text":"Scaling Cooldowns","x":-86,"y":6423,"width":208,"height":50,"color":"3"},
		{"id":"aed2569ef130267f","type":"text","text":"During the cooldown period, the ASG will not launch or terminate additional instances","x":230,"y":6448,"width":714,"height":50,"color":"3"},
		{"id":"e4ca3f66178f9a02","type":"text","text":"CloudWatch Alarms & Scaling","x":-83,"y":5933,"width":292,"height":50,"color":"3"},
		{"id":"4460a1a19ed9ab2a","type":"text","text":"scale an ASG based on CloudWatch alarms","x":304,"y":5933,"width":407,"height":50,"color":"3"},
		{"id":"24f6eec399c36aff","type":"text","text":"CPUUtilization","x":175,"y":6027,"width":181,"height":50,"color":"3"},
		{"id":"00c9c1b59f512024","type":"text","text":"RequestCountPerTarget","x":175,"y":6097,"width":250,"height":50,"color":"3"},
		{"id":"5bf08cf4b5778c4b","type":"text","text":"metrics","x":-83,"y":6141,"width":150,"height":50,"color":"3"},
		{"id":"d601074e21b5fefb","type":"text","text":"Average Network In / Out","x":175,"y":6166,"width":264,"height":50,"color":"3"},
		{"id":"5e263d03ec8ba4ff","type":"text","text":"Connection Draining / Deregistration Delay","x":455,"y":5095,"width":388,"height":50,"color":"3"},
		{"id":"eb90af8f606ec867","type":"text","text":"SSL – Server Name Indication (SNI)","x":455,"y":5169,"width":346,"height":50,"color":"3"},
		{"id":"85ec9abdc515088b","type":"text","text":"Dynamic Scaling","x":432,"y":5517,"width":192,"height":50,"color":"3"},
		{"id":"a37a89bd714f5b3b","type":"text","text":"Scheduled Scaling","x":432,"y":5716,"width":215,"height":50,"color":"3"},
		{"id":"a203f4f9bcdd69ae","type":"text","text":"Predictive scaling","x":432,"y":5812,"width":215,"height":50,"color":"3"}
	],
