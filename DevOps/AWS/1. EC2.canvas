		{"id":"a0925f25365e3a9b","type":"text","text":"• When a CloudWatch alarm is triggered (example CPU > 70%), then add 2 units\n• When a CloudWatch alarm is triggered (example CPU < 30%), then remove 1","x":1036,"y":5547,"width":686,"height":67,"color":"3"},
