		{"id":"d5eff217f804625b","type":"text","text":"Standard","x":3168,"y":-12250,"width":151,"height":50,"color":"3"},
		{"id":"f53b80aca2175cca","type":"text","text":"Availability and durability","x":2826,"y":-12200,"width":287,"height":50,"color":"3"},
		{"id":"e0c518432fd0f365","type":"text","text":"One Zone","x":3168,"y":-12175,"width":151,"height":50,"color":"3"},
		{"id":"ac0fbca94dde6193","type":"text","text":"Standard","x":3341,"y":-12463,"width":162,"height":50,"color":"3"},
		{"id":"17548baeee0ca85a","type":"text","text":" Infrequent access (EFS-IA)","x":3341,"y":-12397,"width":273,"height":50,"color":"3"},
		{"id":"c1f6e6eb1b3c7423","type":"text","text":" Archive","x":3358,"y":-12328,"width":126,"height":50,"color":"3"},
		{"id":"580fcdb8f01fc532","type":"text","text":"Multi-AZ, great for prod","x":3362,"y":-12250,"width":250,"height":50,"color":"3"},
		{"id":"d006f2801ff2383c","type":"text","text":"One AZ, great for dev, backup enabled by default, compatible with IA (EFS One Zone-IA)","x":3362,"y":-12175,"width":761,"height":50,"color":"3"},
		{"id":"8b3fa1ee528c2283","type":"text","text":"Ultra-low latency","x":3486,"y":-10598,"width":200,"height":50,"color":"3"},
		{"id":"a7680485d6c00288","type":"text","text":"NLB has one static IP per AZ, and suppor ts assigning Elastic IP","x":3486,"y":-10524,"width":553,"height":50,"color":"3"},
		{"id":"0b0484b081226237","type":"text","text":"EC2 instances","x":3737,"y":-10409,"width":184,"height":50,"color":"3"},
		{"id":"38563298a2ab7bcc","type":"text","text":"IP Addresses – must be private IPs","x":3737,"y":-10337,"width":334,"height":50,"color":"3"},
		{"id":"d17d612549c96426","type":"text","text":"Target Groups","x":3486,"y":-10314,"width":174,"height":50,"color":"3"},
		{"id":"cbd3a8c3821f1317","type":"text","text":"Application Load Balancer","x":3737,"y":-10264,"width":284,"height":50,"color":"3"},
		{"id":"a6f3932bc18c315a","type":"text","text":"Network Load Balancer","x":3040,"y":-10499,"width":241,"height":50,"color":"3"},
		{"id":"1e996b524e8744ce","type":"text","text":"Lambda functions","x":3800,"y":-11081,"width":231,"height":50,"color":"3"},
		{"id":"7ec4d51f97a1eb82","type":"text","text":"Target Groups","x":3521,"y":-11069,"width":175,"height":50,"color":"3"},
		{"id":"276b2db3c10fa3bb","type":"text","text":"IP Addresses – must be private IPs","x":3800,"y":-11019,"width":329,"height":50,"color":"3"},
		{"id":"b7740dd0c3a5a2d7","type":"text","text":"- ALB can route to multiple target groups\n- Health checks are at the target group level","x":3789,"y":-10876,"width":420,"height":66,"color":"3"},
		{"id":"2b6d141001b1d718","type":"text","text":"Layer 4","x":3483,"y":-10752,"width":149,"height":50,"color":"3"},
		{"id":"c37b08dcc03bfc55","type":"text","text":"Forward TCP & UDP traffic to your instances","x":3483,"y":-10677,"width":406,"height":50,"color":"3"},
		{"id":"33ed8255ad2d00bf","type":"text","text":"load balancer","x":2446,"y":-10839,"width":173,"height":50,"color":"3"},
		{"id":"b4edb5a6166dadec","type":"text","text":" Routing tables","x":3521,"y":-11379,"width":177,"height":50,"color":"3"},
		{"id":"b4a734b61019f9f7","type":"text","text":"EC2 instances","x":3800,"y":-11205,"width":173,"height":50,"color":"3"},
		{"id":"3f04ca0b3e367c2a","type":"text","text":"ECS tasks","x":3800,"y":-11143,"width":141,"height":50,"color":"3"},
		{"id":"174de10802837815","type":"text","text":"Routing based on path in URL (example.com/users & example.com/posts)","x":3868,"y":-11439,"width":620,"height":50,"color":"3"},
		{"id":"b03cb6a8adf707d7","type":"text","text":"Routing based on hostname in URL (one.example.com & other.example.com)","x":3868,"y":-11379,"width":647,"height":50,"color":"3"},
		{"id":"9f1765cbc233f748","type":"text","text":"Routing based on Query String, Headers (example.com/users?id=123&order=false)","x":3868,"y":-11312,"width":691,"height":50,"color":"3"},
		{"id":"ecca2f16ef204176","type":"text","text":"Classic Load Balancer","x":3040,"y":-11666,"width":241,"height":50,"color":"3"},
		{"id":"9d4b274fa460ddc4","type":"text","text":"Layer 7","x":3521,"y":-11641,"width":125,"height":50,"color":"3"},
		{"id":"5309a9b26b4c4f61","type":"text","text":"Application Load Balancer","x":3040,"y":-11599,"width":270,"height":50,"color":"3"},
		{"id":"d546054989456f9b","type":"text","text":"Load balancing to multiple HTTP applications across machines (target groups)","x":3521,"y":-11574,"width":678,"height":50,"color":"3"},
		{"id":"008feb33b1c26e99","type":"text","text":"Load balancing to multiple applications on the same machine (ex: containers)","x":3521,"y":-11516,"width":648,"height":50,"color":"3"},
		{"id":"ca6e9cb5a790431a","type":"text","text":" latency-sensitive use cases (web server, CMS, etc...)","x":3443,"y":-12869,"width":513,"height":50,"color":"3"},
		{"id":"f7894f52e57cc6ba","type":"text","text":"higher latency, throughput, highly parallel (big data, media processing)","x":3358,"y":-12794,"width":619,"height":50,"color":"3"},
		{"id":"fd5730c381e2d644","type":"text","text":"1 TB = 50MiB/s + burst of up to 100MiB/s","x":3404,"y":-12694,"width":387,"height":50,"color":"3"},
		{"id":"b27a60a9bc72b8a5","type":"text","text":"set your throughput regardless of storage size","x":3404,"y":-12617,"width":428,"height":50,"color":"3"},
		{"id":"28931336de2c2332","type":"text","text":"automatically scales throughput up or down based on your workloads","x":3358,"y":-12542,"width":605,"height":50,"color":"3"},
		{"id":"6af233f052cee953","type":"text","text":"General Purpose (default)","x":3115,"y":-12869,"width":264,"height":50,"color":"3"},
		{"id":"07e3ab18e79a6d76","type":"text","text":"Max I/O","x":3115,"y":-12794,"width":155,"height":50,"color":"3"},
		{"id":"b0f523a1f60d86ea","type":"text","text":" Bursting","x":3174,"y":-12694,"width":165,"height":50,"color":"3"},
		{"id":"31a593604302cd16","type":"text","text":"Managed NFS","x":2580,"y":-13243,"width":182,"height":50,"color":"3"},
		{"id":"dfc2bccc2e4ad801","type":"text","text":"EFS works with EC2 instances in multi-AZ","x":2580,"y":-13173,"width":407,"height":52,"color":"3"},
		{"id":"9bdc5c20cb8a6c3d","type":"text","text":"Elastic File System","x":2255,"y":-13107,"width":213,"height":50,"color":"3"},
		{"id":"91c80078e708a9e8","type":"text","text":"Uses security group to control access to EFS","x":2580,"y":-13097,"width":407,"height":50,"color":"3"},
		{"id":"3a77e27a23c94521","type":"text","text":"Anticipate a scaling based on known usage patterns","x":3652,"y":-8361,"width":477,"height":50,"color":"3"},
		{"id":"5c3722d7e4140a0a","type":"text","text":"continuously forecast load and schedule scaling ahead","x":3652,"y":-8268,"width":496,"height":56,"color":"3"},
		{"id":"3e8c85e24ee75c1c","type":"text","text":"Target Tracking Scaling","x":3664,"y":-8610,"width":247,"height":50,"color":"3"},
		{"id":"aab4fae832526526","type":"text","text":"• When a CloudWatch alarm is triggered (example CPU > 70%), then add 2 units\n• When a CloudWatch alarm is triggered (example CPU < 30%), then remove 1","x":3966,"y":-8530,"width":686,"height":67,"color":"3"},
		{"id":"38530a4b69c50f73","type":"text","text":" I want the average ASG CPU to stay at around 40%","x":3989,"y":-8610,"width":466,"height":50,"color":"3"},
		{"id":"cabd5ddc252c1d49","type":"text","text":"Simple / Step Scaling","x":3664,"y":-8522,"width":226,"height":50,"color":"3"},
		{"id":"e5e72df618deba33","type":"text","text":"Cookie generated by the load balancer","x":4535,"y":-9364,"width":370,"height":51,"color":"3"},
		{"id":"c184bcd3aa27c458","type":"text","text":"Custom cookie","x":4566,"y":-9546,"width":191,"height":50,"color":"3"},
		{"id":"88651f38f73bb463","type":"text","text":"Application cookie","x":4566,"y":-9462,"width":212,"height":50,"color":"3"},
		{"id":"6da67c37f251dfc0","type":"text","text":"Generated by the target","x":4845,"y":-9546,"width":250,"height":50,"color":"3"},
		{"id":"d203136c3ac5e428","type":"text","text":"Generated by the load balancer","x":4875,"y":-9462,"width":318,"height":50,"color":"3"},
		{"id":"746924885c213f77","type":"text","text":" the same client is always redirected to the same instance behind a load balancer","x":3854,"y":-9732,"width":686,"height":50,"color":"3"},
		{"id":"81d2fabdcbe65924","type":"text","text":"Sticky Sessions (Session Affinity)","x":3385,"y":-9707,"width":322,"height":50,"color":"3"},
		{"id":"3059839384afebfd","type":"text","text":"works for Classic Load Balancer, Application Load Balancer, and Network Load Balancer","x":3854,"y":-9657,"width":743,"height":50,"color":"3"},
		{"id":"f612441e8d86060b","type":"text","text":"each load balancer instance distributes evenly across all registered instances in all AZ","x":3820,"y":-9232,"width":724,"height":50,"color":"3"},
		{"id":"fdda75be32ec772c","type":"text","text":"Cross-Zone Load Balancing","x":3385,"y":-9187,"width":277,"height":50,"color":"3"},
		{"id":"dc472692f0ef49fc","type":"text","text":"Requests are distributed in the instances of the node of the Elastic Load Balancer","x":3826,"y":-9108,"width":691,"height":50,"color":"3"},
		{"id":"7331d1b2affb14d0","type":"text","text":" Layer 3","x":3387,"y":-10180,"width":139,"height":50,"color":"3"},
		{"id":"7be5796557a5894f","type":"text","text":"Deploy, scale, and manage a fleet of 3rd party network virtual appliances in AWS","x":3385,"y":-10111,"width":684,"height":50,"color":"3"},
		{"id":"7615eb96106600e9","type":"text","text":"Firewalls, Intrusion Detection and Prevention Systems, Deep Packet Inspection Systems, payload manipulation","x":3385,"y":-10042,"width":901,"height":50,"color":"3"},
		{"id":"b4d9f7658b9bdcbe","type":"text","text":"Uses the GENEVE protocol on port 6081","x":3385,"y":-9969,"width":371,"height":50,"color":"3"},
		{"id":"30681a8708282b12","type":"text","text":"Gateway Load Balancer","x":3040,"y":-10061,"width":250,"height":50,"color":"3"},
		{"id":"9b77a48ec7066371","type":"text","text":"EBS Volume Types","x":2255,"y":-13601,"width":214,"height":50,"color":"3"},
		{"id":"ad4a3f55316093fe","type":"text","text":" io1 / io2 Block Express (SSD)","x":2555,"y":-13601,"width":297,"height":50,"color":"3"},
		{"id":"9cc024a255af16eb","type":"text","text":"st1 (HDD)","x":2557,"y":-13498,"width":163,"height":50,"color":"3"},
		{"id":"1e21585a2f26c682","type":"text","text":"sc1 (HDD)","x":2558,"y":-13434,"width":148,"height":50,"color":"3"},
		{"id":"a3bb85c4e9805c51","type":"text","text":"Only gp2/gp3 and io1/io2 Block Express can be used as boot volumes","x":2558,"y":-13356,"width":765,"height":50,"color":"3"},
		{"id":"df278b2e3c240642","type":"text","text":"Lowest cost HDD volume designed for less frequently accessed workloads","x":2764,"y":-13434,"width":647,"height":50,"color":"3"},
		{"id":"05e6028262c7a105","type":"text","text":" Low cost HDD volume designed for frequently accessed","x":2788,"y":-13498,"width":504,"height":50,"color":"3"},
		{"id":"8c83003bb00adf34","type":"text","text":"General Purpose SSD","x":2810,"y":-13723,"width":250,"height":50,"color":"3"},
		{"id":"8eae7dd0b451f30e","type":"text","text":"Supports EBS Multi-attach","x":2932,"y":-13576,"width":294,"height":50,"color":"3"},
		{"id":"56fadbd8ad81c546","type":"text","text":"Highest-performance SSD volume for mission-critical low-latency or high-throughput workloads","x":2934,"y":-13651,"width":806,"height":50,"color":"3"},
		{"id":"be7ec792113157ce","type":"text","text":"Must use a file system that’s cluster-aware","x":3292,"y":-13576,"width":413,"height":52,"color":"3"},
		{"id":"f7a0ce9f197e920c","type":"text","text":" gp2 / gp3 (SSD)","x":2557,"y":-13723,"width":199,"height":50,"color":"3"},
		{"id":"7004d25554135421","type":"text","text":"Storage","x":1927,"y":-14179,"width":135,"height":50,"color":"3"},
		{"id":"3af2acd2c933ac36","type":"text","text":" high-performance hardware disk","x":2594,"y":-14039,"width":322,"height":50,"color":"3"},
		{"id":"ec9eeade55f437bd","type":"text","text":"EC2 Instance Store","x":2255,"y":-13967,"width":220,"height":50,"color":"3"},
		{"id":"12db7e74b9154757","type":"text","text":"lose their storage if they’re stopped (ephemeral)","x":2594,"y":-13967,"width":466,"height":50,"color":"3"},
		{"id":"66647d0d1acff19e","type":"text","text":"Good for buffer / cache / scratch data / temporary content","x":2594,"y":-13896,"width":516,"height":50,"color":"3"},
		{"id":"1c1a7b3f68ba67d8","type":"text","text":"recommended to detach volume to do snapshot","x":2837,"y":-14405,"width":446,"height":50,"color":"3"},
		{"id":"d42148f43983afe3","type":"text","text":"Can copy snapshots across AZ or Region","x":2837,"y":-14341,"width":386,"height":50,"color":"3"},
		{"id":"7b6ba1a138776697","type":"text","text":"EBS Snapshot Archive","x":3030,"y":-14266,"width":233,"height":50,"color":"3"},
		{"id":"4181389c63809ace","type":"text","text":"Features","x":2834,"y":-14234,"width":133,"height":50,"color":"3"},
		{"id":"24eaed58d10ebc8c","type":"text","text":"Recycle Bin for EBS Snapshots","x":3028,"y":-14209,"width":302,"height":50,"color":"3"},
		{"id":"6f6cf259bfcb382f","type":"text","text":"Fast Snapshot Restore (FSR)","x":3028,"y":-14154,"width":312,"height":50,"color":"3"},
		{"id":"c8196cf8f4ec450a","type":"text","text":"EBS (Elastic Block Store)","x":2255,"y":-14625,"width":257,"height":50,"color":"3"},
		{"id":"86c0e6b9747540d5","type":"text","text":"network drive","x":2579,"y":-14625,"width":175,"height":50,"color":"3"},
		{"id":"f193f26e97dfeb46","type":"text","text":"bound to a specific availability zone","x":2579,"y":-14563,"width":338,"height":50,"color":"3"},
		{"id":"9d11955d3f66bea0","type":"text","text":"a backup (snapshot) of your EBS volume at a point in time","x":2837,"y":-14480,"width":503,"height":50,"color":"3"},
		{"id":"56ae741ee2483b06","type":"text","text":"EBS Snapshots","x":2579,"y":-14455,"width":185,"height":50,"color":"3"},
		{"id":"ce8f75494a5f94fe","type":"text","text":"A physical server with EC2 instance capacity fully dedicated to your use","x":2822,"y":-17085,"width":612,"height":50,"color":"3"},
		{"id":"677af912ef3bbe74","type":"text","text":"Dedicated Hosts","x":2408,"y":-17035,"width":250,"height":60,"color":"3"},
		{"id":"c3d7d3b151adcf36","type":"text","text":" Allows you address compliance requirements and use your existing server-bound software licenses (per-socket, per-core, pe—VM software licenses)","x":2822,"y":-17025,"width":1215,"height":50,"color":"3"},
		{"id":"bd780005c10ca3de","type":"text","text":" Purchasing Options:\n• On-demand \n• Reserved","x":2822,"y":-16961,"width":228,"height":104,"color":"3"},
		{"id":"c045019421d65953","type":"text","text":"The most expensive option","x":2822,"y":-16846,"width":274,"height":50,"color":"3"},
		{"id":"a344dc8ae31e6888","type":"text","text":"EC2","x":667,"y":-16821,"width":114,"height":50,"color":"3"},
		{"id":"0b020c4735ded899","type":"text","text":"Dedicated Instances","x":2408,"y":-16664,"width":250,"height":60,"color":"3"},
		{"id":"ebcfbd3d0a760dd5","type":"text","text":"Capacity Reservations","x":2408,"y":-16573,"width":250,"height":60,"color":"3"},
		{"id":"d1bb69226dab1767","type":"text","text":"Instances run on hardware that’s dedicated to you","x":2766,"y":-16659,"width":449,"height":50,"color":"3"},
		{"id":"b1b4e927c3d3768f","type":"text","text":"clusters instances into a low-latency group in a single Availability Zone","x":2820,"y":-16135,"width":604,"height":50,"color":"3"},
		{"id":"64a689f7127105b5","type":"text","text":" If the AZ fails, all instances fails at the same time","x":2820,"y":-16069,"width":452,"height":50,"color":"3"},
		{"id":"b10ee048d21ea561","type":"text","text":"Use case:\n• Big Data job that needs to complete fast\n• Application that needs extremely low latency and high network throughput","x":2820,"y":-16005,"width":683,"height":109,"color":"3"},
		{"id":"7f413d1efe32cabd","type":"text","text":"spreads instances across underlying hardware (max 7 instances per group per AZ)","x":2820,"y":-15855,"width":697,"height":50,"color":"3"},
		{"id":"f88616648c086b96","type":"text","text":"Pros:\n• Can span across Availability Zones (AZ)\n• Reduced risk is simultaneous failure\n• EC2 Instances are on different physical hardware","x":2820,"y":-15787,"width":453,"height":118,"color":"3"},
		{"id":"31ecfd7aefa6ba3a","type":"text","text":"Cons:\n• Limited to 7 instances per AZ per placement group","x":2820,"y":-15651,"width":472,"height":70,"color":"3"},
		{"id":"7038e8c3f74b23af","type":"text","text":"Use case:\n• Application that needs to maximize high availability.\n• Critical Applications where each instance must be isolated from failure from each other.","x":2820,"y":-15563,"width":749,"height":93,"color":"3"},
		{"id":"6cd183e5d1400d96","type":"text","text":"spreads instances across many different partitions (which rely on different sets of racks) within an AZ. Scales to 100s of EC2 instances per group (Hadoop, Cassandra, Kafka)","x":2810,"y":-15389,"width":1385,"height":50,"color":"3"},
		{"id":"5eee905bb7bc85a7","type":"text","text":"Up to 7 partitions per AZ","x":2810,"y":-15327,"width":264,"height":50,"color":"3"},
		{"id":"b87f87dba2b4cce4","type":"text","text":"Elastic Network Interfaces (ENI)","x":2266,"y":-14936,"width":314,"height":50,"color":"3"},
		{"id":"9adffa6af3b05524","type":"text","text":"EC2 Hibernate","x":2266,"y":-14807,"width":176,"height":50,"color":"3"},
		{"id":"733cb45cb3b225c6","type":"text","text":"Root Volume – must be EBS, encrypted, not instance store, and large","x":2514,"y":-14832,"width":591,"height":50,"color":"3"},
		{"id":"2e9021e465fe2052","type":"text","text":"An instance can NOT be hibernated more than 60 days","x":2514,"y":-14764,"width":487,"height":50,"color":"3"},
		{"id":"7770aeccbe684f2a","type":"text","text":"Partition","x":2584,"y":-15261,"width":130,"height":50,"color":"3"},
		{"id":"28028b6f8b4d01ba","type":"text","text":"Can span across multiple AZs in the same region","x":2810,"y":-15261,"width":437,"height":50,"color":"3"},
		{"id":"294a90aeee73db37","type":"text","text":"The instances in a partition do not share racks with the instances in the other partitions","x":2810,"y":-15194,"width":742,"height":50,"color":"3"},
		{"id":"11f2a6fc2adf4d01","type":"text","text":" EC2 instances get access to the partition information as metadata","x":2810,"y":-15130,"width":572,"height":50,"color":"3"},
		{"id":"af54fedb23326962","type":"text","text":"Use cases: HDFS, HBase, Cassandra, Kafka","x":2810,"y":-15064,"width":399,"height":50,"color":"3"},
		{"id":"beec916c3947c411","type":"text","text":"Bound to a specific availability zone (AZ)","x":2679,"y":-14936,"width":389,"height":50,"color":"3"},
		{"id":"3cfcf8f85d938aaa","type":"text","text":"Associate","x":1931,"y":-16317,"width":151,"height":50,"color":"3"},
		{"id":"103019ebd84d64ba","type":"text","text":"Elastic IP","x":2199,"y":-16397,"width":133,"height":50,"color":"3"},
		{"id":"f2c4b94c87fab7f7","type":"text","text":"Placement Groups","x":2266,"y":-16090,"width":209,"height":50,"color":"3"},
		{"id":"9d6db4c2618a1552","type":"text","text":"Cluster","x":2581,"y":-16065,"width":130,"height":50,"color":"3"},
		{"id":"661b7553a12a334e","type":"text","text":"Spread","x":2586,"y":-15787,"width":125,"height":50,"color":"3"},
		{"id":"47a808df3f9657f9","type":"text","text":"fixed public IP for your instance","x":2439,"y":-16417,"width":308,"height":50,"color":"3"},
		{"id":"9c527e65bf516578","type":"text","text":"You can only have 5 Elastic IP in your account","x":2439,"y":-16362,"width":413,"height":50,"color":"3"},
		{"id":"77f21d89477606c9","type":"text","text":" try to avoid using Elastic IP:\n• They often reflect poor architectural decisions\n• Instead, use a random public IP and register a DNS name to it\n• Or, use a Load Balancer and don’t use a public IP","x":2439,"y":-16296,"width":563,"height":116,"color":"3"},
		{"id":"40c27e2d06d4379d","type":"text","text":"Usage beyond EC2 Savings Plans is billed at the On-Demand price","x":2839,"y":-17837,"width":589,"height":60,"color":"3"},
		{"id":"15cb32de4cdc77ba","type":"text","text":"Locked to a specific instance family & AWS region (e.g., M5 in us-east-1)","x":2839,"y":-17750,"width":627,"height":60,"color":"3"},
		{"id":"a1d9223491f77888","type":"text","text":" Flexible across:\n• Instance Size (e.g., m5.xlarge, m5.2xlarge)\n• OS (e.g., Linux, Windows)\n• Tenancy (Host, Dedicated, Default)","x":2839,"y":-17677,"width":421,"height":136,"color":"3"},
		{"id":"b675cc3795c5aed4","type":"text","text":"The MOST cost-efficient instances in AWS","x":2839,"y":-17469,"width":393,"height":50,"color":"3"},
		{"id":"31e0f742a3a82881","type":"text","text":" Useful for workloads that are resilient to failure\n• Batch jobs\n• Data analysis\n• Image processing\n• Any distributed workloads\n• Workloads with a flexible start and end time","x":2839,"y":-17399,"width":434,"height":192,"color":"3"},
		{"id":"c951c0936a7ca014","type":"text","text":" Not suitable for critical jobs or databases","x":2839,"y":-17183,"width":434,"height":50,"color":"3"},
		{"id":"bed83bf4df0d1ba3","type":"text","text":"High Availability","x":2059,"y":-9546,"width":211,"height":50,"color":"3"},
		{"id":"d3f41f083a03c693","type":"text","text":"Features","x":3040,"y":-9410,"width":130,"height":50,"color":"3"},
