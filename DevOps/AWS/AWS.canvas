		{"id":"6ba1e7e12be1fa5c","type":"text","text":"A highly available, scalable, fully managed and Authoritative DNS","x":-5177,"y":-10656,"width":562,"height":50,"color":"5"},
		{"id":"ca79bc3976b02341","type":"text","text":"also a Domain Registrar","x":-4860,"y":-10590,"width":245,"height":50,"color":"5"},
		{"id":"6bd24bb264f0d1a8","type":"text","text":" route traffic to a single resource","x":-5639,"y":-9973,"width":313,"height":50,"color":"5"},
		{"id":"f4c42e8296d6a49b","type":"text","text":"Can specify multiple values in the same record but a random one is chosen by the client\n","x":-5755,"y":-9906,"width":429,"height":72,"color":"5"},
		{"id":"f4314f2a4dec99b0","type":"text","text":"Can’t be associated with health checks","x":-5698,"y":-9812,"width":372,"height":50,"color":"5"},
		{"id":"d55742010e3f4aa5","type":"text","text":"Geolocation","x":-5137,"y":-9636,"width":161,"height":50,"color":"5"},
		{"id":"838e9e64c1ae22e1","type":"text","text":"based on user location","x":-5451,"y":-9636,"width":250,"height":50,"color":"5"},
		{"id":"873739d3f00eef8d","type":"text","text":"Geoproximity","x":-5141,"y":-9554,"width":170,"height":50,"color":"5"},
		{"id":"7a4e180f713ab72d","type":"text","text":"FAILOVER ROUTING POLICY\nDisaster Recovery","x":-5271,"y":-9472,"width":302,"height":64,"color":"5"},
		{"id":"13176248af85b88a","type":"text","text":"Ability to shift more traffic to resources based on the defined bias\nseems like weighted but on the geographic base","x":-5763,"y":-9566,"width":562,"height":75,"color":"5"},
		{"id":"cdfe1f1455d2105c","type":"text","text":"IP-based Routing","x":-5167,"y":-9358,"width":198,"height":50,"color":"5"},
		{"id":"86da71529c035eb2","type":"text","text":"Multi-Value","x":-5136,"y":-9237,"width":167,"height":50,"color":"5"},
		{"id":"5fd5d25ae09c934a","type":"text","text":"Routing is based on clients’ IP addresses","x":-5650,"y":-9373,"width":398,"height":50,"color":"5"},
		{"id":"8fd456d1523442de","type":"text","text":"You provide a list of CIDRs for your clients and the corresponding endpoints/locations (user-IP-to-endpoint mappings)","x":-6217,"y":-9314,"width":965,"height":50,"color":"5"},
		{"id":"617f0f4f7a0fe78f","type":"text","text":"Use when routing traffic to multiple resources","x":-5639,"y":-9237,"width":439,"height":50,"color":"5"},
		{"id":"c724e612fc7bbd07","type":"text","text":"You can use OR, AND, or NOT","x":-5445,"y":-8780,"width":289,"height":50,"color":"5"},
		{"id":"e1f5facc3d794aa1","type":"text","text":"TTL – amount of time the record cached at DNS Resolvers","x":-5404,"y":-8707,"width":504,"height":50,"color":"5"},
		{"id":"8fbb729e59e99f5c","type":"text","text":"Routing Policy – how Route 53 responds to queries","x":-5351,"y":-8637,"width":450,"height":50,"color":"5"},
		{"id":"17d90c620f0d265b","type":"text","text":"Value – e.g., 12.34.56.78","x":-5152,"y":-8569,"width":251,"height":50,"color":"5"},
		{"id":"afab18ae5b92a011","type":"text","text":"Record Type – e.g., A or AAAA","x":-5211,"y":-8499,"width":310,"height":50,"color":"5"},
		{"id":"94dc9d5cc3372a59","type":"text","text":"Domain/subdomain Name – e.g., example.com","x":-5319,"y":-8434,"width":418,"height":50,"color":"5"},
