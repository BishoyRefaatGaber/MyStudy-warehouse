		{"id":"8cb52a29222472e9","type":"text","text":"Deployment Modes","x":-4561,"y":-4590,"width":222,"height":50,"color":"2"},
		{"id":"3e79b59d6f334113","type":"text","text":"Single Instance \nGreat for dev ","x":-4827,"y":-4640,"width":189,"height":75,"color":"2"},
		{"id":"13d5b5029055cf1d","type":"text","text":"High Availability with Load Balancer\nGreat for prod","x":-4992,"y":-4540,"width":354,"height":66,"color":"2"},
		{"id":"d747cfe6b43e0c41","type":"text","text":"Storage","x":-3843,"y":-771,"width":130,"height":50,"color":"4"},
		{"id":"b47d7523115bf9c6","type":"text","text":"S3","x":-4134,"y":-627,"width":89,"height":50,"color":"4"},
		{"id":"838c8ae7236f0d01","type":"text","text":"After enabling Replication, only new objects are replicated","x":-5387,"y":-1774,"width":530,"height":50,"color":"4"},
		{"id":"7424b0f3dde67129","type":"text","text":"existing objects can be replicated using S3 Batch Replication","x":-5386,"y":-1706,"width":529,"height":50,"color":"4"},
		{"id":"9ef3888edcaa3d4f","type":"text","text":"Replication","x":-4757,"y":-1690,"width":159,"height":50,"color":"4"},
		{"id":"8c3b97ee1b123a5e","type":"text","text":"Types","x":-4970,"y":-1615,"width":113,"height":50,"color":"4"},
		{"id":"087dfde28a0e2f0b","type":"text","text":"Can replicate delete markers but Deletions with a version ID are not replicated","x":-5514,"y":-1477,"width":657,"height":50,"color":"4"},
		{"id":"6ce66f9da0ac3c26","type":"text","text":"Same-Region Replication (SRR)","x":-5379,"y":-1640,"width":323,"height":50,"color":"4"},
		{"id":"e040575ebee6daa6","type":"text","text":"Cross-Region Replication (CRR)","x":-5378,"y":-1554,"width":322,"height":50,"color":"4"},
		{"id":"35d5971a70b18b22","type":"text","text":"no “chaining” of replication\nIf bucket 1 has replication into bucket 2, which has replication into bucket 3 then objects created in bucket 1 are not replicated to bucket 3","x":-5493,"y":-1399,"width":636,"height":91,"color":"4"},
		{"id":"86a1f894ecf4bb82","type":"text","text":"Static Website Hosting","x":-4971,"y":-2092,"width":247,"height":50,"color":"4"},
		{"id":"f76183b6166f25bf","type":"text","text":"enabled at the bucket level","x":-5130,"y":-2013,"width":283,"height":50,"color":"4"},
		{"id":"46af1f24d0390d3d","type":"text","text":"Versioning","x":-4760,"y":-1973,"width":151,"height":50,"color":"4"},
		{"id":"97a1f613439c0314","type":"text","text":"Protect against unintended deletes","x":-5186,"y":-1934,"width":339,"height":50,"color":"4"},
		{"id":"d9763c96d26b717e","type":"text","text":"Must enable Versioning","x":-5107,"y":-1844,"width":250,"height":50,"color":"4"},
		{"id":"540b8a1a08172ee1","type":"text","text":"User-Based","x":-4993,"y":-2594,"width":155,"height":50,"color":"4"},
		{"id":"46e9227c8d87249a","type":"text","text":"Security","x":-4736,"y":-2476,"width":129,"height":50,"color":"4"},
		{"id":"44b43a2a3cdb5434","type":"text","text":"Resource-Based","x":-5039,"y":-2451,"width":201,"height":50,"color":"4"},
		{"id":"b80d85e1a998c60e","type":"text","text":"Encryption","x":-4987,"y":-2327,"width":149,"height":50,"color":"4"},
		{"id":"f160b506e031e322","type":"text","text":"Bucket settings for Block Public Access","x":-4985,"y":-2234,"width":367,"height":50,"color":"4"},
		{"id":"e8ffdbbab8e5c48f","type":"text","text":"Object Access Control List (ACL) ","x":-5434,"y":-2451,"width":326,"height":50,"color":"4"},
		{"id":"49edd73256d4327c","type":"text","text":"Bucket Access Control List (ACL)","x":-5434,"y":-2380,"width":328,"height":50,"color":"4"},
		{"id":"ce6bccb7eeddfb0f","type":"text","text":"Bucket Policies","x":-5288,"y":-2526,"width":180,"height":50,"color":"4"},
		{"id":"5859c6d834b2aa81","type":"text","text":"IAM Policies","x":-5232,"y":-2594,"width":164,"height":50,"color":"4"},
		{"id":"e183c09de082dcef","type":"text","text":"settings were created to prevent company data leaks","x":-5570,"y":-2234,"width":485,"height":50,"color":"4"},
		{"id":"30641c45dce3d935","type":"text","text":"Buckets","x":-4742,"y":-2919,"width":133,"height":50,"color":"4"},
		{"id":"a1619bddf9d7f202","type":"text","text":"Objects","x":-4736,"y":-2828,"width":125,"height":50,"color":"4"},
		{"id":"360e42883f3bd48b","type":"text","text":"advertised as ”infinitely scaling” storage","x":-5010,"y":-3325,"width":382,"height":50,"color":"4"},
		{"id":"b7ff16694599759f","type":"text","text":"• Backup and storage\n• Disaster Recovery\n• Archive\n• Hybrid Cloud storage\n• Application hosting\n• Media hosting\n• Data lakes & big data analytics\n• Software delivery\n• Static website","x":-5154,"y":-3258,"width":309,"height":268,"color":"4"},
		{"id":"1a84602ce5748de0","type":"text","text":"use cases","x":-4776,"y":-3163,"width":148,"height":50,"color":"4"},
		{"id":"705c97ae73866b85","type":"text","text":"globally unique name (across all regions all accounts)","x":-5275,"y":-2919,"width":471,"height":50,"color":"4"},
		{"id":"60fa4ad30d0a86ec","type":"text","text":"have a Key","x":-4966,"y":-2853,"width":152,"height":50,"color":"4"},
		{"id":"f76813d9d7b06e34","type":"text","text":"key = prefix + object name\ns3://my-bucket/my_folder1/another_folder/my_file.txt","x":-5278,"y":-2778,"width":464,"height":82,"color":"4"},
		{"id":"e0a253de57efbd53","type":"text","text":"Glacier","x":-5116,"y":-586,"width":140,"height":50,"color":"4"},
		{"id":"d65c6e99474576c2","type":"text","text":"Glacier Instant Retrieval","x":-5465,"y":-611,"width":250,"height":50,"color":"4"},
		{"id":"e8c66dd459d51635","type":"text","text":"Glacier Deep Archive","x":-5439,"y":-441,"width":224,"height":50,"color":"4"},
		{"id":"2ecd462a91ad88f7","type":"text","text":"Intelligent Tiering","x":-5174,"y":-345,"width":198,"height":50,"color":"4"},
		{"id":"6aa548b90042c313","type":"text","text":"Can move between classes manually or using S3 Lifecycle configurations","x":-5593,"y":-259,"width":617,"height":50,"color":"4"},
		{"id":"b3c9e8d881eacc27","type":"text","text":"Low-cost object storage meant for archiving / backup\nPricing: price for storage + object retrieval cost","x":-5688,"y":-697,"width":473,"height":58,"color":"4"},
		{"id":"79f0c42db4e88afd","type":"text","text":"Glacier Flexible Retrieval","x":-5465,"y":-531,"width":250,"height":50,"color":"4"},
		{"id":"da68896faf43261a","type":"text","text":"Expedited (1 to 5 minutes), Standard (3 to 5 hours), Bulk (5 to 12 hours) – free\nMinimum storage duration of 90 days","x":-6177,"y":-536,"width":655,"height":60,"color":"4"},
		{"id":"436c851571d87f05","type":"text","text":"great for data accessed once a quarter\nMinimum storage duration of 90 days","x":-5908,"y":-616,"width":381,"height":60,"color":"4"},
		{"id":"cf92cd8f2d0eed21","type":"text","text":"Standard (12 hours), Bulk (48 hours)\nMinimum storage duration of 180 days","x":-5872,"y":-446,"width":358,"height":60,"color":"4"},
		{"id":"5b96ab01d5d29a5e","type":"text","text":"Moves objects automatically between Access Tiers based on usage\nno retrieval charges in S3 Intelligent-Tiering","x":-5810,"y":-357,"width":592,"height":75,"color":"4"},
		{"id":"b9dddc88d4594971","type":"text","text":"For data that is less frequently accessed, but requires rapid access when needed\n99.99% Availability","x":-5997,"y":-979,"width":683,"height":60,"color":"4"},
		{"id":"2f23fc2efd703a30","type":"text","text":"Disaster Recovery, backups\n99.9% Availability","x":-5997,"y":-922,"width":279,"height":76,"color":"4"},
		{"id":"ea47f7517f70e9c7","type":"text","text":"Standard-Infrequent Access (IA)","x":-5677,"y":-909,"width":309,"height":50,"color":"4"},
		{"id":"b085f652cea42f05","type":"text","text":"High durability (99.999999999%) in a single AZ\n99.5% Availability\nStoring secondary backup copies of on-premises data, or data you can recreate","x":-6348,"y":-828,"width":671,"height":98,"color":"4"},
		{"id":"30744822015c3a80","type":"text","text":"One Zone-Infrequent Access","x":-5623,"y":-804,"width":283,"height":50,"color":"4"},
		{"id":"5a1222cb292cd4d3","type":"text","text":"Standard – General Purpose","x":-5252,"y":-1122,"width":276,"height":50,"color":"4"},
		{"id":"6d20b2d21f89083c","type":"text","text":"Infrequent Access","x":-5198,"y":-899,"width":222,"height":50,"color":"4"},
		{"id":"6b3eafa9c040df2e","type":"text","text":"S3 Storage Classes","x":-4804,"y":-661,"width":230,"height":50,"color":"4"},
		{"id":"046d82bac88fbeae","type":"text","text":"Used for frequently accessed data","x":-5675,"y":-1220,"width":335,"height":51,"color":"4"},
		{"id":"429c99fda88eb9ab","type":"text","text":"Low latency and high throughput","x":-5667,"y":-1144,"width":327,"height":50,"color":"4"},
		{"id":"6f776c2ff8ad22c3","type":"text","text":"Sustain 2 concurrent facility failures","x":-5693,"y":-1072,"width":353,"height":51,"color":"4"},
		{"id":"27f2ebf9cf1ac178","type":"text","text":"Lifecycle Rules","x":-4754,"y":-145,"width":180,"height":50,"color":"4"},
		{"id":"37ce4cdfcf02d736","type":"text","text":"Expiration actions","x":-5029,"y":-95,"width":206,"height":50,"color":"4"},
		{"id":"e2c52ff4915f9602","type":"text","text":"configure objects to expire (delete) after some time","x":-5570,"y":-95,"width":468,"height":50,"color":"4"},
		{"id":"f926a07f5efd91a6","type":"text","text":"Transition Actions","x":-5041,"y":-175,"width":218,"height":50,"color":"4"},
		{"id":"3970c26fe882bdf8","type":"text","text":"configure objects to transition to another storage class","x":-5610,"y":-175,"width":500,"height":50,"color":"4"},
		{"id":"b5107e0ca7143b3a","type":"text","text":"S3 Analytics – Storage Class Analysis","x":-4930,"y":-15,"width":356,"height":50,"color":"4"},
		{"id":"4051952c33815471","type":"text","text":"Help you decide when to transition objects to the right storage class","x":-5576,"y":-15,"width":583,"height":50,"color":"4"},
		{"id":"107d059fa18a13a6","type":"text","text":"Requester Pays","x":-4757,"y":94,"width":183,"height":50,"color":"4"},
		{"id":"3be668b6c36660d8","type":"text","text":"-  In general, bucket owners pay for all Amazon S3 storage and data transfer costs associated with their bucket\n- the requester instead of the bucket owner pays the cost of the request and the data download from the bucket","x":-5815,"y":82,"width":958,"height":75,"color":"4"},
		{"id":"08b1686492424a92","type":"text","text":"Event Notifications","x":-4783,"y":184,"width":209,"height":50,"color":"4"},
		{"id":"cfb2b21c4bea7aaa","type":"text","text":"do some processing on an event occurrence","x":-5256,"y":184,"width":404,"height":50,"color":"4"},
		{"id":"692c4a26ef3df372","type":"text","text":"Baseline Performance","x":-4811,"y":302,"width":237,"height":50,"color":"4"},
		{"id":"22364e088ef51169","type":"text","text":"- recommended for files > 100MB, must use for files > 5GB\n- Can help parallelize uploads (speed up transfers)","x":-5705,"y":270,"width":533,"height":82,"color":"4"},
		{"id":"ea65843f504e0582","type":"text","text":"- Increase transfer speed by transferring file to an AWS edge location which will forward the data to the S3 bucket in the target region\n- Compatible with multi-part upload","x":-6326,"y":377,"width":1111,"height":82,"color":"4"},
		{"id":"7fe34fa002d269bc","type":"text","text":"Multi-Part upload","x":-5094,"y":286,"width":203,"height":50,"color":"4"},
		{"id":"aa596627c2bafcbd","type":"text","text":"S3 Transfer Acceleration","x":-5150,"y":393,"width":259,"height":50,"color":"4"},
		{"id":"e22e98d603ecbebd","type":"text","text":"S3 Byte-Range Fetches","x":-5297,"y":534,"width":246,"height":50,"color":"4"},
		{"id":"e17e93772e9d46f6","type":"text","text":"see the videos ","x":-4977,"y":459,"width":250,"height":60,"color":"4"},
		{"id":"e4fd0b1faa146e5e","type":"text","text":"security","x":-4745,"y":2277,"width":133,"height":50,"color":"4"},
		{"id":"fcbc85c68efc5d78","type":"text","text":"Encryption","x":-5152,"y":937,"width":159,"height":50,"color":"4"},
		{"id":"8ac2c8bd1cf98053","type":"text","text":"Enabled by Default","x":-6922,"y":584,"width":231,"height":50,"color":"4"},
		{"id":"f670d0aef7d8efb8","type":"text","text":"Server-Side Encryption with Amazon S3-Managed Keys (SSE-S3)","x":-6611,"y":584,"width":559,"height":50,"color":"4"},
		{"id":"dc9ee088c69b3cc1","type":"text","text":"Server-Side Encryption with KMS Keys stored in AWS KMS (SSE-KMS)","x":-6666,"y":662,"width":614,"height":50,"color":"4"},
		{"id":"b1c0d8a7a6290566","type":"text","text":"Server-Side Encryption with Customer-Provided Keys (SSE-C)","x":-6602,"y":732,"width":550,"height":50,"color":"4"},
		{"id":"6f62c5978262ddf8","type":"text","text":"Server-Side Encryption (SSE)","x":-5949,"y":653,"width":293,"height":50,"color":"4"},
		{"id":"52bb0d41c4cd6b87","type":"text","text":"Client-Side Encryption","x":-5904,"y":826,"width":248,"height":50,"color":"4"},
		{"id":"a85f20f490fed39e","type":"text","text":"Encryption in transit (SSL/TLS)","x":-5637,"y":1005,"width":305,"height":50,"color":"4"},
		{"id":"efb29b262344fd8f","type":"text","text":"Object Encryption","x":-5541,"y":765,"width":216,"height":50,"color":"4"},
		{"id":"6d68e01b02e17f43","type":"text","text":"Default Encryption vs. Bucket Policies","x":-5692,"y":1277,"width":367,"height":50,"color":"4"},
		{"id":"fcaa70609e95005d","type":"text","text":"HTTPS is recommended","x":-5976,"y":935,"width":250,"height":50,"color":"4"},
		{"id":"f27906c5ae045590","type":"text","text":"HTTPS is mandatory for SSE-C","x":-6033,"y":1010,"width":307,"height":50,"color":"4"},
		{"id":"57aa8b972bd2b841","type":"text","text":"set condition aws:SecureTransport to false in bucket policy","x":-6628,"y":1101,"width":538,"height":50,"color":"4"},
		{"id":"9003895dda83bf24","type":"text","text":"Force Encryption in Transit","x":-6033,"y":1101,"width":307,"height":50,"color":"4"},
		{"id":"e311c3aa73f4892b","type":"text","text":"SSE-S3 encryption is automatically applied to new objects stored in S3 bucket","x":-6510,"y":1194,"width":659,"height":50,"color":"4"},
		{"id":"da31553a3749c5fb","type":"text","text":"Bucket Policies are evaluated before “Default Encryption”","x":-6350,"y":1264,"width":499,"height":50,"color":"4"},
		{"id":"dde1d45ef82c7214","type":"text","text":"Optionally, you can “force encryption” using a bucket policy and refuse any API call\nto PUT an S3 object without encryption headers (SSE-KMS or SSE-C)","x":-6560,"y":1327,"width":709,"height":60,"color":"4"},
		{"id":"cd1120a693281181","type":"text","text":"CORS","x":-5103,"y":1569,"width":110,"height":50,"color":"4"},
		{"id":"e8c4faa2f0a425ef","type":"text","text":"Cross-Origin Resource Sharing (CORS)","x":-5598,"y":1447,"width":379,"height":50,"color":"4"},
		{"id":"11a8573ad269e37b","type":"text","text":"Origin = scheme (protocol) + host (domain) + por t","x":-5691,"y":1519,"width":472,"height":50,"color":"4"},
		{"id":"cbfecbba8585bd25","type":"text","text":"Web Browser based mechanism to allow requests to other origins while visiting the main origin","x":-6032,"y":1594,"width":813,"height":50,"color":"4"},
		{"id":"d5f750e87afeb042","type":"text","text":"The requests won’t be fulfilled unless the other origin allows for the requests, using CORS Headers","x":-6031,"y":1678,"width":812,"height":50,"color":"4"},
		{"id":"abac4bb547182b29","type":"text","text":"If a client makes a cross-origin request on our S3 bucket, we need to enable the correct CORS headers\n","x":-6063,"y":1762,"width":853,"height":50,"color":"4"},
		{"id":"7cc9c700aa150254","type":"text","text":"MFA Delete","x":-5152,"y":1910,"width":159,"height":50,"color":"4"},
		{"id":"4e7fac671ae6e256","type":"text","text":"To use MFA Delete, Versioning must be enabled on the bucket","x":-5798,"y":1935,"width":548,"height":50,"color":"4"},
		{"id":"5740e44d1d571758","type":"text","text":"force users to generate a code on a device  before doing important operations on S3","x":-5950,"y":1867,"width":700,"height":50,"color":"4"},
		{"id":"efba156004ee7e86","type":"text","text":"Only the bucket owner (root account) can enable/disable MFA Delete\nEnabled from CLI or API call","x":-5842,"y":2003,"width":592,"height":69,"color":"4"},
		{"id":"62b2d26be27b51f5","type":"text","text":"Access Logs","x":-5160,"y":2169,"width":167,"height":50,"color":"4"},
		{"id":"9033e7b9a3e1f7ed","type":"text","text":"Any request made to S3, from any account, authorized or denied, will be logged into another S3 bucket","x":-6102,"y":2135,"width":852,"height":50,"color":"4"},
		{"id":"ab06711646bff8b9","type":"text","text":"The target logging bucket must be in the same AWS region","x":-5785,"y":2204,"width":535,"height":50,"color":"4"},
		{"id":"8b3c56cdaafe6599","type":"text","text":"Do not set your logging bucket to be the monitored bucket\nIt will create a logging loop, and your bucket will grow exponentially","x":-5829,"y":2263,"width":579,"height":76,"color":"4"},
		{"id":"95241bba9912f917","type":"text","text":"Pre-Signed URLs","x":-5201,"y":2453,"width":208,"height":50,"color":"4"},
		{"id":"09be10218dff9e6b","type":"text","text":"Generate pre-signed URLs using the S3 Console, AWS CLI or SDK","x":-5847,"y":2403,"width":562,"height":50,"color":"4"},
		{"id":"e3c62b83dbd6dd22","type":"text","text":"Users given a pre-signed URL inherit the permissions of the user that generated the URL for GET / PUT","x":-6130,"y":2478,"width":845,"height":50,"color":"4"},
		{"id":"aaa4204c785f3e92","type":"text","text":"Object Lock","x":-5178,"y":2970,"width":162,"height":50,"color":"4"},
		{"id":"ba5b517979c14244","type":"text","text":"Block an object version deletion for a specified amount of time","x":-5856,"y":2909,"width":540,"height":50,"color":"4"},
		{"id":"a97641dc1dfe7610","type":"text","text":"Adopt a WORM (Write Once Read Many) model","x":-5739,"y":2845,"width":423,"height":50,"color":"4"},
		{"id":"85a73dfcd26cbbaf","type":"text","text":"versioning must be enabled","x":-5613,"y":2785,"width":296,"height":50,"color":"4"},
		{"id":"99c0b9d7064011f2","type":"text","text":"Retention modes","x":-5539,"y":3057,"width":209,"height":50,"color":"4"},
		{"id":"546c66dee395c56e","type":"text","text":"Compliance","x":-5792,"y":3007,"width":166,"height":50,"color":"4"},
		{"id":"98888bec8cca41b1","type":"text","text":"Governance","x":-5792,"y":3106,"width":160,"height":50,"color":"4"},
		{"id":"a979da9c7edf00cb","type":"text","text":"Retention Period","x":-5552,"y":3230,"width":222,"height":50,"color":"4"},
		{"id":"61e484f623f073d5","type":"text","text":"protect the object for a fixed period, it can be extended","x":-6127,"y":3230,"width":492,"height":50,"color":"4"},
		{"id":"326e86a0c6eb7424","type":"text","text":"-  Object versions can't be overwritten or deleted by any user, including the root user\n-  Objects retention modes can't be changed, and retention periods can't be shortened","x":-6647,"y":2995,"width":782,"height":74,"color":"4"},
		{"id":"7ccbd347c76b8e42","type":"text","text":"• Most users can't overwrite or delete an object version or alter its lock settings\n• Some users have special permissions to change the retention or delete the object","x":-6586,"y":3106,"width":721,"height":74,"color":"4"},
		{"id":"81126401258706a2","type":"text","text":"• protect the object indefinitely, independent from retention period\n• can be freely placed and removed using the s3:PutObjectLegalHold IAM permission","x":-6407,"y":3350,"width":809,"height":74,"color":"4"},
		{"id":"fb7490311b6dbb9e","type":"text","text":"Legal Hold","x":-5491,"y":3362,"width":161,"height":50,"color":"4"},
		{"id":"1d9532a93db6004a","type":"text","text":"Adopt a WORM (Write Once Read Many) model","x":-5716,"y":2581,"width":435,"height":52,"color":"4"},
		{"id":"79be3b2a2b635eb6","type":"text","text":"Lock the policy for future edits (can no longer be changed or deleted)","x":-5873,"y":2659,"width":597,"height":50,"color":"4"},
		{"id":"1ca0c2a5d728e58a","type":"text","text":"Glacier Vault Lock","x":-5210,"y":2607,"width":213,"height":52,"color":"4"},
		{"id":"ec1ecca7397da55e","type":"text","text":"Access Points","x":-5210,"y":3509,"width":194,"height":50,"color":"4"},
		{"id":"3b6f7d6065945068","type":"text","text":"Improves read performance, content is cached at the edge","x":-5173,"y":-7288,"width":516,"height":50,"color":"5"},
		{"id":"c13511ca795e0661","type":"text","text":"Origins","x":-4778,"y":-7070,"width":121,"height":50,"color":"5"},
		{"id":"a1df2f13b5d675a4","type":"text","text":"S3 bucket","x":-4980,"y":-7138,"width":143,"height":50,"color":"5"},
		{"id":"dd5a7f2e4ab7922c","type":"text","text":"VPC Origin","x":-4993,"y":-7070,"width":157,"height":50,"color":"5"},
		{"id":"485e2f5b15cf068a","type":"text","text":"Custom Origin (HTTP)","x":-5070,"y":-7002,"width":233,"height":50,"color":"5"},
		{"id":"34904f6235de3530","type":"text","text":"Geo Restriction","x":-4840,"y":-6834,"width":183,"height":50,"color":"5"},
		{"id":"6cccf6272b44b062","type":"text","text":" restrict who can access your distribution","x":-5340,"y":-6917,"width":391,"height":50,"color":"5"},
		{"id":"f90f50fbd285437a","type":"text","text":"Allowlist","x":-5096,"y":-6834,"width":143,"height":50,"color":"5"},
		{"id":"2b0a67c69b72c06d","type":"text","text":"Blocklist","x":-5087,"y":-6769,"width":134,"height":50,"color":"5"},
		{"id":"926535e0949bb272","type":"text","text":"Allow users to access content","x":-5444,"y":-6834,"width":300,"height":50,"color":"5"},
		{"id":"e226575f4500b3ae","type":"text","text":"Prevent users from accessing content","x":-5495,"y":-6769,"width":351,"height":50,"color":"5"},
		{"id":"d7360e9eb0045e4b","type":"text","text":"approved countries","x":-5168,"y":-6680,"width":219,"height":50,"color":"5"},
		{"id":"08f7010c40a0f31c","type":"text","text":"banned countries","x":-5163,"y":-6609,"width":210,"height":50,"color":"5"},
		{"id":"df6bb87b63c0cfcd","type":"text","text":"The “country” is determined using a 3rd party Geo-IP database","x":-5806,"y":-6634,"width":558,"height":50,"color":"5"},
		{"id":"bddbf1bc232f2d1e","type":"text","text":"Price Classes","x":-4832,"y":-6450,"width":175,"height":50,"color":"5"},
		{"id":"66b816f3b9a88111","type":"text","text":"all regions – best performance","x":-5481,"y":-6500,"width":305,"height":50,"color":"5"},
		{"id":"0b614428497ac25d","type":"text","text":"most regions, but excludes the most expensive regions","x":-5674,"y":-6420,"width":482,"height":50,"color":"5"},
		{"id":"a0b67478ba1cc647","type":"text","text":"only the least expensive regions","x":-5487,"y":-6346,"width":323,"height":50,"color":"5"},
		{"id":"dc50ceab7af6a036","type":"text","text":"Price Class 100","x":-5110,"y":-6346,"width":180,"height":50,"color":"5"},
		{"id":"aeb7ace9daa9430f","type":"text","text":"Price Class 200","x":-5130,"y":-6420,"width":200,"height":50,"color":"5"},
		{"id":"bdb16214c67b4c70","type":"text","text":"Price Class All","x":-5103,"y":-6500,"width":173,"height":50,"color":"5"},
		{"id":"7782742ecba000c8","type":"text","text":"Files are cached for a TTL (maybe a day)","x":-5036,"y":-7215,"width":379,"height":50,"color":"5"},
		{"id":"62d1aa130b68e00d","type":"text","text":"force an entire or partial cache refresh by performing a CloudFront Invalidation before TTL expiration in case of updating the back-end  Borigin","x":-6099,"y":-6244,"width":1169,"height":52,"color":"5"},
		{"id":"86d1777ebdb21048","type":"text","text":"Cache Invalidations","x":-4876,"y":-6244,"width":219,"height":50,"color":"5"},
		{"id":"b654918634015810","type":"text","text":"AWS Global Accelerator","x":-4378,"y":-6091,"width":250,"height":60,"color":"5"},
		{"id":"2c5b029e5a4bdbe1","type":"text","text":"Improve global application availability and performance using the AWS global network","x":-5225,"y":-6126,"width":732,"height":50,"color":"5"},
		{"id":"46248b79e189fb16","type":"text","text":"Uses anycast IP. The Anycast IP send traffic directly to Edge Locations","x":-5103,"y":-6051,"width":610,"height":50,"color":"5"},
		{"id":"fcd3d65ba35dda9c","type":"text","text":"DDoS protection thanks to AWS Shield","x":-4859,"y":-5980,"width":365,"height":50,"color":"5"},
		{"id":"38399919b9eec2d2","type":"text","text":"Snowball","x":-4179,"y":3588,"width":134,"height":50,"color":"4"},
		{"id":"0ab73457c742f8c3","type":"text","text":"DataSync","x":-4195,"y":3735,"width":150,"height":50,"color":"4"},
		{"id":"da18c84725c42ced","type":"text","text":"Move large amount of data to and from","x":-4635,"y":3695,"width":360,"height":50,"color":"4"},
		{"id":"21de149d103ca5b0","type":"text","text":"On-premises / other cloud to AWS (NFS, SMB, HDFS, S3 API...)","x":-5251,"y":3665,"width":542,"height":50,"color":"4"},
		{"id":"729e6d77bc88454b","type":"text","text":"AWS to AWS (different storage services)","x":-5081,"y":3740,"width":372,"height":50,"color":"4"},
		{"id":"f1f8401023a9c537","type":"text","text":"no agent needed","x":-5356,"y":3740,"width":211,"height":50,"color":"4"},
		{"id":"2bb7b71d8f4024b2","type":"text","text":"needs agent","x":-5479,"y":3665,"width":160,"height":50,"color":"4"},
		{"id":"cb0649e8d3a55012","type":"text","text":"synchronize to","x":-4466,"y":3879,"width":191,"height":50,"color":"4"},
		{"id":"5840b359199d1b57","type":"text","text":"Amazon FSx","x":-4719,"y":3969,"width":159,"height":50,"color":"4"},
		{"id":"c0d613dbeea0bac8","type":"text","text":"Amazon EFS","x":-4719,"y":3894,"width":159,"height":50,"color":"4"},
		{"id":"1304f45d23679f91","type":"text","text":"Amazon S3","x":-4719,"y":3830,"width":160,"height":50,"color":"4"},
		{"id":"fc2df68c06c27259","type":"text","text":"integration","x":-4298,"y":-11101,"width":170,"height":50,"color":"#0064c8"},
		{"id":"78ec049ba9224faa","type":"text","text":"Amazon MQ","x":-4603,"y":-10874,"width":167,"height":50,"color":"#0064c8"},
		{"id":"55e1d5d055cc5e53","type":"text","text":"Amazon MQ is a managed message broker service for on-prime","x":-5207,"y":-10874,"width":549,"height":50,"color":"#0064c8"},
		{"id":"87af65e469c79162","type":"text","text":" real-time big data streaming","x":-5116,"y":-11162,"width":288,"height":50,"color":"#0064c8"},
		{"id":"35f26f1abff81f42","type":"text","text":"Amazon Kinesis Data Streams","x":-4749,"y":-11102,"width":313,"height":50,"color":"#0064c8"},
		{"id":"f36f57e430362a0e","type":"text","text":"Amazon SQS – Simple Queue Service","x":-4795,"y":-13883,"width":359,"height":50,"color":"#0064c8"},
		{"id":"aea76251b9b6ee11","type":"text","text":"Unlimited throughput, unlimited number of messages in queue","x":-5541,"y":-14254,"width":537,"height":50,"color":"#0064c8"},
		{"id":"da32a1befb6867ae","type":"text","text":"used to decouple applications","x":-5296,"y":-14325,"width":292,"height":50,"color":"#0064c8"},
		{"id":"42d6e8f2824a9f1a","type":"text","text":"Producing Messages","x":-5226,"y":-14123,"width":222,"height":50,"color":"#0064c8"},
		{"id":"6c0a211b62bb73af","type":"text","text":"Message retention: default 4 days, up to 14 days","x":-5767,"y":-14030,"width":436,"height":50,"color":"#0064c8"},
		{"id":"28d1f9fe5680f71b","type":"text","text":"The message is persisted in SQS until a consumer deletes it","x":-5854,"y":-14098,"width":523,"height":50,"color":"#0064c8"},
		{"id":"8dd82bb9a8f9aea4","type":"text","text":"Produced to SQS using the SDK (SendMessage API)","x":-5791,"y":-14165,"width":460,"height":50,"color":"#0064c8"},
		{"id":"f63b7689b838da81","type":"text","text":"Consuming Messages","x":-5248,"y":-13902,"width":244,"height":50,"color":"#0064c8"},
		{"id":"5fd313de7b93c300","type":"text","text":"Multiple EC2 Instances Consumers","x":-5668,"y":-13952,"width":337,"height":50,"color":"#0064c8"},
		{"id":"f109be4fe6e95600","type":"text","text":"Consumers receive and process messages in parallel","x":-6216,"y":-13952,"width":472,"height":50,"color":"#0064c8"},
		{"id":"5c482000edfd1f8d","type":"text","text":"At least once delivery","x":-5980,"y":-13877,"width":236,"height":50,"color":"#0064c8"},
		{"id":"d71607eb4d33d645","type":"text","text":"We can scale consumers horizontally to improve throughput of processing","x":-6375,"y":-13799,"width":631,"height":50,"color":"#0064c8"},
		{"id":"6ee46e74c23c3a60","type":"text","text":"Auto Scaling Group (ASG)","x":-5296,"y":-13720,"width":283,"height":51,"color":"#0064c8"},
		{"id":"d18770af33eae2e4","type":"text","text":"for producers and for consumers","x":-5668,"y":-13720,"width":316,"height":50,"color":"#0064c8"},
		{"id":"4d6c1deb87e8db10","type":"text","text":"Security","x":-5143,"y":-13536,"width":130,"height":50,"color":"#0064c8"},
		{"id":"168940e71dd14db1","type":"text","text":"Encryption","x":-5404,"y":-13601,"width":158,"height":50,"color":"#0064c8"},
		{"id":"2c1e1be713e54ece","type":"text","text":"Access Controls","x":-5456,"y":-13406,"width":210,"height":50,"color":"#0064c8"},
		{"id":"e52a26133b5b2b12","type":"text","text":" Client-side encryption","x":-5767,"y":-13518,"width":250,"height":50,"color":"#0064c8"},
		{"id":"180681b06e83f00b","type":"text","text":"At-rest encryption using KMS keys","x":-5856,"y":-13576,"width":339,"height":50,"color":"#0064c8"},
		{"id":"c876a45f7d37eb29","type":"text","text":"In-flight encryption using HTTPS API","x":-5874,"y":-13646,"width":357,"height":50,"color":"#0064c8"},
		{"id":"bf498045c426158b","type":"text","text":"IAM policies to regulate access to the SQS API","x":-5953,"y":-13406,"width":419,"height":50,"color":"#0064c8"},
		{"id":"a0a6628eeb081630","type":"text","text":"SQS Access Policies","x":-5464,"y":-13291,"width":218,"height":50,"color":"#0064c8"},
		{"id":"7d5624945df37158","type":"text","text":"Useful for allowing other services (SNS, S3...) to write to an SQS queue","x":-6160,"y":-13259,"width":603,"height":50,"color":"#0064c8"},
		{"id":"575399574217c275","type":"text","text":"Useful for cross-account access to SQS queues","x":-5985,"y":-13326,"width":428,"height":50,"color":"#0064c8"},
		{"id":"731f64039872429b","type":"text","text":"After a message is polled by a consumer, it becomes invisible to other consumers","x":-6065,"y":-13172,"width":690,"height":50,"color":"#0064c8"},
		{"id":"86dad5a086203c79","type":"text","text":"By default it is 30 seconds","x":-5647,"y":-13097,"width":272,"height":50,"color":"#0064c8"},
		{"id":"72d9613fcfd61bc8","type":"text","text":"A consumer could call the ChangeMessageVisibility API to get more time","x":-5991,"y":-13020,"width":616,"height":50,"color":"#0064c8"},
		{"id":"1e88ef9ccdb65321","type":"text","text":" If visibility timeout is high (hours), and consumer crashes, re-processing will take time","x":-6105,"y":-12947,"width":730,"height":50,"color":"#0064c8"},
		{"id":"4d7345e633f23578","type":"text","text":"If visibility timeout is too low (seconds), we may get duplicates","x":-5919,"y":-12874,"width":544,"height":50,"color":"#0064c8"},
		{"id":"34c1a9a46b3082a0","type":"text","text":"Message Visibility Timeout","x":-5285,"y":-13062,"width":272,"height":50,"color":"#0064c8"},
		{"id":"9b7aacb8dac9cd2c","type":"text","text":"When a consumer requests messages from the queue, it can optionally “wait” for messages to arrive if there are none in the queue","x":-6338,"y":-12781,"width":1053,"height":50,"color":"#0064c8"},
		{"id":"e94e863106dc17d5","type":"text","text":"LongPolling decreases the number of API calls made to SQS while increasing the efficiency and reducing latency of your application","x":-6374,"y":-12701,"width":1089,"height":50,"color":"#0064c8"},
		{"id":"a587cbd4895b3e01","type":"text","text":"Long Polling","x":-5175,"y":-12751,"width":162,"height":50,"color":"#0064c8"},
		{"id":"aeaabfaaa9952d82","type":"text","text":"FIFO Queue","x":-5192,"y":-12567,"width":179,"height":50,"color":"#0064c8"},
		{"id":"e27476dde585b334","type":"text","text":"Limited throughput: 300 msg/s without batching, 3000 msg/s with","x":-5858,"y":-12607,"width":593,"height":50,"color":"#0064c8"},
		{"id":"bcb2058691ad7067","type":"text","text":"cloud native","x":-4895,"y":-12482,"width":170,"height":50,"color":"#0064c8"},
		{"id":"b361be1508a28c10","type":"text","text":"send one message to many receivers","x":-5095,"y":-12422,"width":370,"height":50,"color":"#0064c8"},
		{"id":"7054c78216276b6c","type":"text","text":"Each subscriber to the topic will get all the messages","x":-5207,"y":-12349,"width":482,"height":50,"color":"#0064c8"},
		{"id":"0b5cdbfae96c0b3c","type":"text","text":"Amazon SNS","x":-4603,"y":-12007,"width":167,"height":50,"color":"#0064c8"},
		{"id":"dcdfb683e1ae821c","type":"text","text":"How to publish","x":-4908,"y":-12179,"width":183,"height":50,"color":"#0064c8"},
		{"id":"185217d082ba146e","type":"text","text":"Topic Publish (using the SDK)","x":-5304,"y":-12232,"width":290,"height":50,"color":"#0064c8"},
		{"id":"fbcc6225fcb2fb65","type":"text","text":"Direct Publish (for mobile apps SDK)","x":-5353,"y":-12049,"width":339,"height":50,"color":"#0064c8"},
		{"id":"1a95053899818766","type":"text","text":"Create a subscription (or many)","x":-5704,"y":-12282,"width":304,"height":50,"color":"#0064c8"},
		{"id":"ac3a7c64d07b7abe","type":"text","text":"Create a topic","x":-5573,"y":-12349,"width":173,"height":50,"color":"#0064c8"},
		{"id":"47373c5a067ed4f8","type":"text","text":"Publish to the topic","x":-5613,"y":-12207,"width":213,"height":50,"color":"#0064c8"},
		{"id":"0a05faec0405f24b","type":"text","text":"Works with Google GCM, Apple APNS, Amazon ADM...","x":-5930,"y":-11935,"width":478,"height":50,"color":"#0064c8"},
		{"id":"801e057603ab09b3","type":"text","text":"Publish to the platform endpoint","x":-5764,"y":-12003,"width":312,"height":50,"color":"#0064c8"},
		{"id":"a3681682aa54992e","type":"text","text":"Create a platform endpoint","x":-5732,"y":-12069,"width":279,"height":50,"color":"#0064c8"},
		{"id":"a7873d109db83810","type":"text","text":" Create a platform application","x":-5765,"y":-12137,"width":312,"height":50,"color":"#0064c8"},
		{"id":"b210df8368026023","type":"text","text":"Security","x":-4867,"y":-11795,"width":142,"height":50,"color":"#0064c8"},
		{"id":"0b459f84b2636792","type":"text","text":" Access Controls","x":-5159,"y":-11805,"width":193,"height":50,"color":"#0064c8"},
		{"id":"908d6e1f97db1dea","type":"text","text":"SNS Access Policies","x":-5197,"y":-11745,"width":231,"height":50,"color":"#0064c8"},
		{"id":"735cd0b945e270b6","type":"text","text":"Encryption","x":-5136,"y":-11860,"width":170,"height":50,"color":"#0064c8"},
		{"id":"a54483327257dea8","type":"text","text":"same as SQS","x":-5400,"y":-11805,"width":188,"height":50,"color":"#0064c8"},
		{"id":"d77f27f25ed786b4","type":"text","text":"SNS + SQS: Fan Out","x":-4951,"y":-11640,"width":226,"height":50,"color":"#0064c8"},
		{"id":"c8b052ad25b9b64d","type":"text","text":"Push once in SNS, receive in all SQS queues that are subscribers","x":-5590,"y":-11678,"width":559,"height":50,"color":"#0064c8"},
		{"id":"0a2f36a0f55399cf","type":"text","text":"Fully decoupled, no data loss","x":-5333,"y":-11605,"width":300,"height":50,"color":"#0064c8"},
		{"id":"a8006a48d8539bec","type":"text","text":"FIFO Topic","x":-4908,"y":-11444,"width":183,"height":50,"color":"#0064c8"},
		{"id":"6e1a5922bda7762c","type":"text","text":"Ordering by Message Group ID","x":-5574,"y":-12531,"width":309,"height":50,"color":"#0064c8"},
		{"id":"5c61335fefec7100","type":"text","text":"Exactly-once send capability (by removing duplicates using Deduplication ID)","x":-5916,"y":-12472,"width":651,"height":50,"color":"#0064c8"},
		{"id":"fed2efc354300263","type":"text","text":"Similar features as SQS FIFO","x":-5281,"y":-11494,"width":290,"height":50,"color":"#0064c8"},
		{"id":"161c217e8252cae6","type":"text","text":"Can have SQS Standard and FIFO queues as subscribers","x":-5503,"y":-11419,"width":512,"height":50,"color":"#0064c8"},
		{"id":"4a1fa8415548a2d8","type":"text","text":"Message Filtering","x":-4924,"y":-11271,"width":199,"height":50,"color":"#0064c8"},
		{"id":"2711686a8b689e93","type":"text","text":" If a subscription doesn’t have a filter policy, it receives every message","x":-5609,"y":-11246,"width":601,"height":50,"color":"#0064c8"},
		{"id":"8313a95e81fc6dd1","type":"text","text":"JSON policy used to filter messages sent to SNS topic’s subscriptions","x":-5616,"y":-11321,"width":608,"height":50,"color":"#0064c8"},
		{"id":"c53973c40a56aa7b","type":"text","text":"Capacity Modes","x":-5022,"y":-11024,"width":194,"height":50,"color":"#0064c8"},
		{"id":"101cf05868072a9f","type":"text","text":"Provisioned mode","x":-5311,"y":-11054,"width":220,"height":50,"color":"#0064c8"},
		{"id":"3431441ff67b14df","type":"text","text":"On-demand mode","x":-5306,"y":-11000,"width":215,"height":50,"color":"#0064c8"},
		{"id":"def592c8e2766742","type":"text","text":"No need to provision or manage the capacity","x":-5789,"y":-11000,"width":416,"height":50,"color":"#0064c8"},
		{"id":"41ff92f21bfbc0c9","type":"text","text":"Choose number of shards","x":-5644,"y":-11054,"width":271,"height":50,"color":"#0064c8"},
		{"id":"67b7547c7f8621f6","type":"text","text":"Amazon Data Firehose","x":-4672,"y":-10938,"width":236,"height":50,"color":"#0064c8"},
		{"id":"680aa06de3c14b89","type":"text","text":"Launch Types","x":330,"y":-5487,"width":185,"height":50},
		{"id":"cd9b8ebdaf3d7eb7","type":"text","text":"EC2 Launch Type","x":605,"y":-5533,"width":199,"height":50},
		{"id":"7bca62313a690a27","type":"text","text":"You must provision & maintain the infrastructure (the EC2 instances)","x":866,"y":-5533,"width":582,"height":50,"color":"3"},
		{"id":"d37b8d615a56448c","type":"text","text":" You do not provision the infrastructure (no EC2 instances to manage)","x":917,"y":-5459,"width":592,"height":60,"color":"3"},
		{"id":"ed304b107f929332","type":"text","text":"Fargate Launch Type","x":605,"y":-5454,"width":245,"height":50,"color":"3"},
		{"id":"199f65199909ed2d","type":"text","text":" IAM Roles for ECS","x":330,"y":-5359,"width":218,"height":50},
		{"id":"e2a890bc6e003aeb","type":"text","text":"EC2 Instance Profile (EC2 Launch Type only)","x":621,"y":-5384,"width":407,"height":50},
		{"id":"d6a6d33fbd7403e4","type":"text","text":"ECS Task Role","x":621,"y":-5310,"width":185,"height":50},
		{"id":"d170ed83275e36d1","type":"text","text":"Load Balancer Integrations","x":334,"y":-5231,"width":291,"height":50},
		{"id":"2a20e99b07021d30","type":"text","text":"Data Volumes (EFS)","x":334,"y":-5132,"width":215,"height":50},
		{"id":"d455b22a30ff5a26","type":"text","text":"Fargate + EFS = Serverless","x":620,"y":-5089,"width":289,"height":50},
		{"id":"bd623ef53f487e67","type":"text","text":"Works for both EC2 and Fargate launch types","x":620,"y":-5159,"width":415,"height":50},
		{"id":"961f53384fb8f4f7","type":"text","text":"Auto Scaling ","x":337,"y":-4988,"width":172,"height":50},
		{"id":"4325decdbe78dc6f","type":"text","text":"scale policy","x":598,"y":-4963,"width":167,"height":50},
		{"id":"75860e1d1e3104ad","type":"text","text":"Step Scaling","x":863,"y":-4959,"width":173,"height":50},
		{"id":"19de89d0e176d837","type":"text","text":"scale based on a specified CloudWatch Alarm","x":1135,"y":-4959,"width":414,"height":50},
		{"id":"1db705ddf37dced8","type":"text","text":"Scheduled Scaling","x":863,"y":-4899,"width":212,"height":50},
		{"id":"c17a6efeb361d96a","type":"text","text":"scale based on a specified date/time (predictable changes)","x":1135,"y":-4899,"width":522,"height":50},
		{"id":"2c7be0524dee473d","type":"text","text":" Target Tracking","x":863,"y":-5013,"width":192,"height":50},
		{"id":"e945a2c6bd6f7dbe","type":"text","text":" scale based on target value for a specific CloudWatch metric","x":1135,"y":-5013,"width":525,"height":50},
		{"id":"d8634a43bc341968","type":"text","text":"Fargate Auto Scaling is much easier to setup (because Serverless)","x":598,"y":-4753,"width":576,"height":50},
		{"id":"63d6ee59ddf74c4a","type":"text","text":" ECS Service Auto Scaling (task level) ≠ EC2 Auto Scaling (EC2 instance level)","x":598,"y":-4822,"width":674,"height":50},
		{"id":"618fc0dff5b68584","type":"text","text":"EKS","x":-79,"y":-4551,"width":101,"height":50},
		{"id":"c123e80cfb5ad680","type":"text","text":"Amazon EKS = Amazon Elastic Kubernetes Service","x":129,"y":-4655,"width":460,"height":50},
		{"id":"b0366e8754ae021f","type":"text","text":"Node Types","x":129,"y":-4526,"width":161,"height":50},
		{"id":"77524007bdde36bd","type":"text","text":"Managed Node Groups","x":359,"y":-4576,"width":244,"height":50},
		{"id":"609d1e73c4f24a31","type":"text","text":"Self-Managed Nodes","x":361,"y":-4501,"width":250,"height":50},
		{"id":"23c4f2e17ca834bc","type":"text","text":"AWS Fargate","x":361,"y":-4439,"width":185,"height":50},
		{"id":"760893a60fdf6e5c","type":"text","text":"No maintenance required; no nodes managed","x":603,"y":-4439,"width":415,"height":50},
		{"id":"fbf1f9018cf992e9","type":"text","text":"Creates and manages Nodes (EC2 instances) for you","x":663,"y":-4576,"width":494,"height":50},
		{"id":"096687402018cc62","type":"text","text":"Nodes created by you and registered to the EKS cluster and managed by an ASG","x":671,"y":-4501,"width":693,"height":50},
		{"id":"130eddccafaed752","type":"text","text":"Leverages a Container Storage Interface (CSI) compliant driver","x":394,"y":-4292,"width":573,"height":50},
		{"id":"ee6f47608011f013","type":"text","text":"Need to specify StorageClass manifest on your EKS cluster","x":394,"y":-4365,"width":522,"height":50},
		{"id":"3d50b0ee1b89a9e3","type":"text","text":"Data Volumes","x":129,"y":-4340,"width":185,"height":50},
		{"id":"7ef72c342eaea786","type":"text","text":" in VPC","x":-5065,"y":6028,"width":147,"height":50,"color":"#ff006f"},
		{"id":"f94b47339c35327f","type":"text","text":"Lambda will create an ENI (Elastic Network Interface) in your subnets","x":-5802,"y":6053,"width":605,"height":50,"color":"#ff006f"},
		{"id":"5d20468e34da400b","type":"text","text":"You must define the VPC ID, the Subnets and the Security Groups","x":-5769,"y":6128,"width":572,"height":50,"color":"#ff006f"},
		{"id":"9e98a17499334c88","type":"text","text":"f Lambda functions directly access your database, they may open too many connections under high load","x":-6067,"y":6260,"width":870,"height":50,"color":"#ff006f"},
		{"id":"3f66afbd7d115c71","type":"text","text":" Improve scalability by pooling and sharing DB connections","x":-5715,"y":6335,"width":518,"height":50,"color":"#ff006f"},
		{"id":"e79a3c589b87fb71","type":"text","text":"The Lambda function must be deployed in your VPC, because RDS Proxy is never publicly accessible","x":-6025,"y":6420,"width":828,"height":50,"color":"#ff006f"},
		{"id":"6474dbe71aa094a4","type":"text","text":"with RDS Proxy","x":-5102,"y":6335,"width":184,"height":50,"color":"#ff006f"},
		{"id":"08faf23e5e897fc7","type":"text","text":"NoSQL database","x":-5082,"y":6515,"width":197,"height":50,"color":"#ff006f"},
		{"id":"6e437016150a8101","type":"text","text":"Lambda functions written in NodeJS or Python","x":-6132,"y":5588,"width":436,"height":50,"color":"#ff006f"},
		{"id":"f8d0cc52f9ac3c22","type":"text","text":"Lambda@Edge","x":-5609,"y":5638,"width":180,"height":50,"color":"#ff006f"},
		{"id":"26e4729100e9e339","type":"text","text":"Used to change CloudFront requests and responses","x":-6169,"y":5736,"width":473,"height":50,"color":"#ff006f"},
		{"id":"030a63a286dd255c","type":"text","text":"By default, your Lambda function is launched outside your own VPC Therefore, it cannot access resources in VPC","x":-6125,"y":5978,"width":928,"height":50,"color":"#ff006f"},
		{"id":"bfead10b2211fd37","type":"text","text":"Viewer Request","x":-6534,"y":5375,"width":199,"height":50,"color":"#ff006f"},
		{"id":"42219cd1fe28ea98","type":"text","text":"Viewer Response","x":-6550,"y":5450,"width":215,"height":50,"color":"#ff006f"},
