		{"id":"e04ab66ccca32538","type":"text","text":"Manual DB Snapshots","x":638,"y":3846,"width":232,"height":50,"color":"#00ffc1"},
		{"id":"08645b009e64e76c","type":"text","text":"Faster than snapshot & restore","x":704,"y":3920,"width":305,"height":50,"color":"#00ffc1"},
		{"id":"dc53f88c07e19467","type":"text","text":"Aurora Database Cloning","x":382,"y":3970,"width":253,"height":50,"color":"#00ffc1"},
		{"id":"2def140e51c1baaf","type":"text","text":"Uses copy-on-write protocol","x":704,"y":3991,"width":282,"height":50,"color":"#00ffc1"},
		{"id":"15ee52586efa0f69","type":"text","text":"Aurora Cross Region Read Replicas","x":656,"y":3171,"width":340,"height":50,"color":"#00ffc1"},
		{"id":"11f4844670cc743c","type":"text","text":"Aurora Global Database (recommended)","x":642,"y":3249,"width":376,"height":50,"color":"#00ffc1"},
		{"id":"3926e66ba81090ad","type":"text","text":"Enables you to add ML-based predictions to\nyour applications via SQL","x":751,"y":3368,"width":333,"height":99,"color":"#00ffc1"},
		{"id":"b42c079bde9b62c5","type":"text","text":"Supported services\n- Amazon SageMaker (use with any ML model)\n- Amazon Comprehend (for sentiment analysis)","x":751,"y":3484,"width":442,"height":125,"color":"#00ffc1"},
		{"id":"0baec71b2e180d50","type":"text","text":"Allows Aurora PostgreSQL to understand commands targeted for MS SQL Server","x":758,"y":3673,"width":691,"height":50,"color":"#00ffc1"},
		{"id":"769c209fbf3dfd8d","type":"text","text":"- Useful for disaster recovery\n- Simple to put in place","x":1061,"y":3130,"width":323,"height":83,"color":"#00ffc1"},
		{"id":"88710c1d80b52edf","type":"text","text":"- 1 Primary Region (read / write)\n- Up to 5 secondary (read-only) regions, replication lag is less than 1 second","x":1061,"y":3249,"width":671,"height":83,"color":"#00ffc1"},
		{"id":"f358765d69db4323","type":"text","text":"Global Aurora","x":372,"y":3199,"width":181,"height":50,"color":"#00ffc1"},
		{"id":"70450e27a7506ebe","type":"text","text":"Aurora Serverless","x":376,"y":3051,"width":204,"height":50,"color":"#00ffc1"},
