		{"id":"e18cf7b5f2a735f4","type":"text","text":"container for records that define how to route traffic to a domain and its subdomains","x":-5605,"y":-7710,"width":724,"height":50,"color":"5"},
		{"id":"09e7d391d8118170","type":"text","text":"Hosted Zones","x":-4796,"y":-7660,"width":176,"height":50,"color":"5"},
		{"id":"63c10c0c178079c2","type":"text","text":"contains records that specify how to route traffic on the Internet (public domain names)","x":-5955,"y":-7610,"width":737,"height":50,"color":"5"},
