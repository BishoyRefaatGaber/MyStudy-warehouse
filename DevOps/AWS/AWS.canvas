		{"id":"e6f469d797713468","type":"text","text":"Define a subset of Aurora Instances as a Custom Endpoint","x":963,"y":2937,"width":518,"height":50,"color":"#00ffc1"},
		{"id":"c754880e04c604ca","type":"text","text":"Run analytical queries on specific replicas","x":963,"y":3012,"width":380,"height":50,"color":"#00ffc1"},
		{"id":"0c078567403d08d5","type":"text","text":"Amazon Aurora","x":22,"y":2586,"width":195,"height":50,"color":"#00ffc1"},
		{"id":"3421e3feb3a905ef","type":"text","text":"Aurora costs more than RDS (20% more) – but is more efficient","x":367,"y":2561,"width":559,"height":50,"color":"#00ffc1"},
		{"id":"4fa5346e93250436","type":"text","text":"DB Cluster","x":372,"y":2767,"width":146,"height":50,"color":"#00ffc1"},
		{"id":"043af1dad5997329","type":"text","text":"Additional features","x":372,"y":2937,"width":212,"height":50,"color":"#00ffc1"},
		{"id":"4dfd7541a937725e","type":"text","text":"Writer Endpoint Pointing to the master","x":609,"y":2717,"width":354,"height":50,"color":"#00ffc1"},
		{"id":"df60f495a0dcb5dc","type":"text","text":"Reader Endpoint Connection Load Balancing","x":609,"y":2802,"width":409,"height":50,"color":"#00ffc1"},
		{"id":"43468f460dfc8fa9","type":"text","text":"good for infrequent, intermittent or unpredictable workloads...","x":367,"y":2636,"width":559,"height":50,"color":"#00ffc1"},
		{"id":"40187fefcb6efe8b","type":"text","text":"Using ElastiCache involves heavy application code changes","x":467,"y":5304,"width":522,"height":50,"color":"#00ffc1"},
		{"id":"ef71f530f46b3dac","type":"text","text":"Applications queries ElastiCache, if not available, get from RDS and store in ElastiCache.","x":467,"y":5373,"width":731,"height":50,"color":"#00ffc1"},
		{"id":"390115a36857ada7","type":"text","text":"ElastiCache","x":163,"y":5395,"width":180,"height":50,"color":"#00ffc1"},
		{"id":"f3b1dfa4543d67c7","type":"text","text":"Cache must have an invalidation strategy to make sure only the most current data is used in there.","x":467,"y":5445,"width":807,"height":50,"color":"#00ffc1"},
		{"id":"a880ce358dac4e63","type":"text","text":"There are only two hard things in Computer Science: cache invalidation and naming things","x":995,"y":6553,"width":749,"height":50,"color":"#00ffc1"},
		{"id":"98ed711ea325a48b","type":"text","text":"store temporary session data in a cache (using TTL features)","x":1042,"y":6456,"width":525,"height":50,"color":"#00ffc1"},
		{"id":"88b1b9c7b69dbcf2","type":"text","text":"all the read data is cached, data can become stale in cache","x":1073,"y":6268,"width":513,"height":50,"color":"#00ffc1"},
		{"id":"a3a572a6d8d0401d","type":"text","text":"Adds or update data in the cache when written to a DB (no stale data)","x":1073,"y":6377,"width":593,"height":50,"color":"#00ffc1"},
		{"id":"4d353132e1a93b6b","type":"text","text":"Patterns for ElastiCache","x":467,"y":6427,"width":257,"height":50,"color":"#00ffc1"},
		{"id":"389e3462edf96e7c","type":"text","text":"Lazy Loading","x":828,"y":6268,"width":170,"height":50,"color":"#00ffc1"},
		{"id":"2742fdad47662f22","type":"text","text":"Write Through","x":828,"y":6377,"width":187,"height":50,"color":"#00ffc1"},
		{"id":"77bcc8c4e109d2f6","type":"text","text":"Session Store","x":828,"y":6456,"width":170,"height":50,"color":"#00ffc1"},
		{"id":"13a7416585bcd65a","type":"text","text":"Quote","x":828,"y":6553,"width":113,"height":50,"color":"#00ffc1"},
		{"id":"ab7d385f7162ae26","type":"text","text":"Cache Security","x":467,"y":6038,"width":192,"height":50,"color":"#00ffc1"},
		{"id":"366b3880c07b787e","type":"text","text":" Redis AUTH","x":746,"y":6013,"width":158,"height":50,"color":"#00ffc1"},
		{"id":"eea4a12a09582cc7","type":"text","text":"Memcached -->  Supports SASL-based authentication (advanced)","x":746,"y":6181,"width":564,"height":50,"color":"#00ffc1"},
		{"id":"8a29a66809014f23","type":"text","text":"set a “password/token” when you create a Redis cluster","x":995,"y":5978,"width":490,"height":50,"color":"#00ffc1"},
		{"id":"2d22c5e0c430abd4","type":"text","text":"an extra level of security for your cache (on top of security groups)","x":995,"y":6038,"width":569,"height":50,"color":"#00ffc1"},
		{"id":"e43279c9826dab39","type":"text","text":"Support SSL in flight encryption","x":995,"y":6098,"width":315,"height":50,"color":"#00ffc1"},
		{"id":"72129ef2d669be83","type":"text","text":"REDIS","x":776,"y":5587,"width":114,"height":50,"color":"#00ffc1"},
		{"id":"34042b2f258e7b6f","type":"text","text":"Redis vs Memcached","x":467,"y":5668,"width":228,"height":50,"color":"#00ffc1"},
		{"id":"db0add57c1c36206","type":"text","text":"MEMCACHED","x":776,"y":5764,"width":182,"height":50,"color":"#00ffc1"},
		{"id":"67e25d70e4c41e86","type":"text","text":"IAM Authentication for Redis","x":746,"y":5908,"width":283,"height":50,"color":"#00ffc1"},
		{"id":"6f45cdf6ca3c93e9","type":"text","text":"- Multi AZ with Auto-Failover\n- Read Replicas to scale reads and have high availability\n- Data Durability using AOF persistence\n- Backup and restore features\n- Supports Sets and Sorted Sets","x":958,"y":5530,"width":505,"height":163,"color":"#00ffc1"},
		{"id":"def248ad6ab5d752","type":"text","text":"- Multi-node for partitioning of data (sharding)\n- No high availability (replication)\n- Non persistent\n- Backup and restore (Serverless)\n- Multi-threaded architecture","x":1026,"y":5706,"width":435,"height":167,"color":"#00ffc1"},
		{"id":"d031b8fd4bef7cfb","type":"text","text":"only used for AWS API-level security","x":1086,"y":5906,"width":388,"height":55,"color":"#00ffc1"},
		{"id":"a1b1e6043b0fb73f","type":"text","text":"Security Groups","x":959,"y":4829,"width":193,"height":50,"color":"#00ffc1"},
		{"id":"6f9b9a9d690bb519","type":"text","text":"No SSH available","x":959,"y":4898,"width":193,"height":50,"color":"#00ffc1"},
		{"id":"bae775aa108fd64f","type":"text","text":"Audit Logs can be enabled","x":959,"y":4968,"width":266,"height":50,"color":"#00ffc1"},
		{"id":"e24484aebe8a4300","type":"text","text":" except on RDS Custom","x":1225,"y":4898,"width":246,"height":50,"color":"#00ffc1"},
		{"id":"4e4422c58edfd253","type":"text","text":"TLS-ready by default, use the AWS TLS root certificates client-side","x":1243,"y":4688,"width":586,"height":50,"color":"#00ffc1"},
		{"id":"7dfc9d988753dba9","type":"text","text":" sent to CloudWatch Logs for longer retention","x":1282,"y":4968,"width":415,"height":50,"color":"#00ffc1"},
		{"id":"9377a964078ad18b","type":"text","text":"In-flight encryption","x":957,"y":4688,"width":215,"height":50,"color":"#00ffc1"},
		{"id":"29452a7691862026","type":"text","text":"IAM Authentication","x":959,"y":4759,"width":211,"height":50,"color":"#00ffc1"},
		{"id":"c71120bb37f9499e","type":"text","text":"RDS & Aurora Security","x":607,"y":4779,"width":237,"height":50,"color":"#00ffc1"},
		{"id":"4ba66b4186e108cb","type":"text","text":"in-memory databases with high performance, low latency","x":467,"y":5096,"width":523,"height":50,"color":"#00ffc1"},
		{"id":"b490f44f28ff474f","type":"text","text":"Helps reduce load off databases for read intensive workloads","x":467,"y":5164,"width":546,"height":50,"color":"#00ffc1"},
		{"id":"c9743f575f0448d2","type":"text","text":"get managed Redis or Memcached","x":467,"y":5232,"width":328,"height":50,"color":"#00ffc1"},
