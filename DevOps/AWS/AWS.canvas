		{"id":"731dd4cfd143a821","type":"text","text":"Limits","x":-5032,"y":4565,"width":114,"height":50,"color":"#ff006f"},
		{"id":"441af753c16dd642","type":"text","text":"per region","x":-5343,"y":4182,"width":146,"height":50,"color":"#ff006f"},
		{"id":"e308f8dadba0542e","type":"text","text":"Deployment","x":-5591,"y":4253,"width":160,"height":50,"color":"#ff006f"},
		{"id":"3649c0b2fee1bb56","type":"text","text":"Concurrency and Throttling","x":-5475,"y":4444,"width":278,"height":50,"color":"#ff006f"},
		{"id":"f78536392e78a61f","type":"text","text":"• Memory allocation: 128 MB – 10GB (1 MB increments)\n• Maximum execution time: 900 seconds (15 minutes)\n• Environment variables (4 KB)\n• Disk capacity in the “function container” (in /tmp): 512 MB to 10GB\n• Concurrency executions: 1000 (can be increased)","x":-6265,"y":4049,"width":595,"height":158,"color":"#ff006f"},
		{"id":"c98d757f6181edb5","type":"text","text":"• Lambda function deployment size (compressed .zip): 50 MB\n• Size of uncompressed deployment (code + dependencies): 250 MB\n• Can use the /tmp directory to load other files at startup\n• Size of environment variables: 4 KB","x":-6265,"y":4213,"width":595,"height":131,"color":"#ff006f"},
		{"id":"588175bcd0755267","type":"text","text":"Concurrency limit: up to 1000 concurrent executions","x":-6036,"y":4419,"width":467,"height":50,"color":"#ff006f"},
		{"id":"d0061f698bf0c40e","type":"text","text":"Each invocation over the concurrency limit will trigger a “Throttle”","x":-6139,"y":4494,"width":570,"height":50,"color":"#ff006f"},
		{"id":"8520539ecbef58de","type":"text","text":"Throttle behavior","x":-5769,"y":4604,"width":201,"height":50,"color":"#ff006f"},
		{"id":"60ef9bdb6e1252b4","type":"text","text":" If synchronous invocation => return ThrottleError - 429","x":-6353,"y":4579,"width":499,"height":50,"color":"#ff006f"},
		{"id":"d13f9a292c1be22b","type":"text","text":" If asynchronous invocation => retry automatically and then go to DLQ","x":-6452,"y":4657,"width":598,"height":50,"color":"#ff006f"},
		{"id":"fad9a6cc742173b2","type":"text","text":"Give users an identity to interact with our web or mobile application","x":-5350,"y":8663,"width":577,"height":50,"color":"#ff006f"},
		{"id":"234992fedcfd0406","type":"text","text":"Cognito","x":-4648,"y":8663,"width":125,"height":50,"color":"#ff006f"},
		{"id":"bfed1cefe4329ab6","type":"text","text":"Create a serverless database of user for your web & mobile apps","x":-5662,"y":8733,"width":565,"height":50,"color":"#ff006f"},
		{"id":"8c91c35c2fe20eb8","type":"text","text":"Cognito User Pools","x":-5015,"y":8733,"width":242,"height":50,"color":"#ff006f"},
		{"id":"98c82a3978036110","type":"text","text":"Get identities for “users” so they obtain temporary AWS credentials","x":-5854,"y":8808,"width":597,"height":50,"color":"#ff006f"},
