		{"id":"75560a0378da8f43","type":"text","text":"Recommended for shor t-term and un-interrupted workloads, where you can't predict how the application will behave","x":2822,"y":-18651,"width":952,"height":50,"color":"3"},
		{"id":"cab6abe0b81df719","type":"text","text":"Reservation Period – 1 year (+discount) or 3 years (+++discount)","x":2841,"y":-18408,"width":575,"height":50,"color":"3"},
