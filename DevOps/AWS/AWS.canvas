		{"id":"5dcf8f65ab914747","type":"text","text":" Restoring MySQL Aurora cluster from S3","x":960,"y":4365,"width":371,"height":50,"color":"#00ffc1"},
		{"id":"5cfc7ea02da213a5","type":"text","text":"Database master & replicas encryption using AWS KMS – must be defined as launch time","x":1246,"y":4458,"width":754,"height":50,"color":"#00ffc1"},
		{"id":"6ff8cc8ba15edb37","type":"text","text":" If the master is not encrypted, the read replicas cannot be encrypted","x":1246,"y":4527,"width":587,"height":50,"color":"#00ffc1"},
		{"id":"705319dfc0b795a0","type":"text","text":"To encrypt an un-encrypted database, go through a DB snapshot & restore as encrypted","x":1246,"y":4596,"width":742,"height":50,"color":"#00ffc1"},
