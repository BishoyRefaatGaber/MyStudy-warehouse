		{"id":"293cabbacabc4ed5","type":"text","text":" PostgreSQL and MySQL","x":367,"y":2496,"width":254,"height":50,"color":"#00ffc1"},
		{"id":"94fa4319713a7840","type":"text","text":" in a stopped RDS database, you will still pay for storage. If you plan on\nstopping it for a long time, you should snapshot & restore instead","x":558,"y":2189,"width":607,"height":59,"color":"#00ffc1"},
		{"id":"e88e4768b7544f02","type":"text","text":"Managed Oracle and Microsoft SQL Server Database with OS and database customization","x":563,"y":1826,"width":747,"height":50,"color":"#00ffc1"},
		{"id":"36e8d3c96df67afd","type":"text","text":"De-activate Automation Mode to perform your customization, better to take a DB snapshot before","x":563,"y":1901,"width":805,"height":50,"color":"#00ffc1"},
		{"id":"aee3b1d361ab1f1a","type":"text","text":"The following happens internally:\n- A snapshot is taken\n-  A new DB is restored from the snapshot in a new AZ\n- Synchronization is established between the two databases","x":1039,"y":1635,"width":552,"height":150,"color":"#00ffc1"},
		{"id":"3a8a74ede0f39f3c","type":"text","text":"click on “modify”","x":1048,"y":1547,"width":213,"height":50,"color":"#00ffc1"},
		{"id":"def91e4731534916","type":"text","text":"Reduced RDS & Aurora failover time by up 66%","x":593,"y":2351,"width":420,"height":50,"color":"#00ffc1"},
		{"id":"63d4306d53d8f266","type":"text","text":"Fully managed database proxy for RDS","x":593,"y":2276,"width":365,"height":50,"color":"#00ffc1"},
		{"id":"82eb1b4a86a344c2","type":"text","text":" Disaster recovery in case of region issue","x":1068,"y":1297,"width":394,"height":50,"color":"#00ffc1"},
		{"id":"369ecba2087ed049","type":"text","text":"Local performance for global reads","x":1068,"y":1384,"width":333,"height":50,"color":"#00ffc1"},
		{"id":"e27de799e1758bcf","type":"text","text":" Read Replicas","x":691,"y":961,"width":179,"height":60,"color":"#05ffc1"},
		{"id":"6faffd3ee32aecca","type":"text","text":"Scale the read workload of your DB","x":944,"y":911,"width":395,"height":50,"color":"#05ffc1"},
		{"id":"57102d6ef6db6bbc","type":"text","text":"No fees for RDS Read Replicas within the same region but there’s a network cost when data goes from one AZ to another cross region","x":944,"y":991,"width":1089,"height":50,"color":"#05ffc1"},
		{"id":"40a4866deb57b1d6","type":"text","text":"Failover to standby in case of AZ outage (high availability)","x":911,"y":1219,"width":512,"height":50,"color":"#05ffc1"},
		{"id":"d0a99916916611eb","type":"text","text":"Not used for scaling","x":911,"y":1148,"width":226,"height":50,"color":"#00ffc1"},
		{"id":"657b1b9d0466665c","type":"text","text":"Zero downtime operation","x":1048,"y":1472,"width":267,"height":50,"color":"#00ffc1"},
		{"id":"756bfda501d0d94e","type":"text","text":"managed DB service for DB use SQL as a query language.","x":312,"y":817,"width":509,"height":54,"color":"#05ffc1"},
		{"id":"46ad00e5850f5c95","type":"text","text":"RDS Deployments","x":312,"y":1109,"width":208,"height":60,"color":"#05ffc1"},
		{"id":"c3624d363a277e7d","type":"text","text":"Amazon RDS","x":22,"y":1169,"width":178,"height":50,"color":"#05ffc1"},
		{"id":"c169bd5fdb49af44","type":"text","text":"Multi-AZ","x":691,"y":1219,"width":146,"height":50,"color":"#05ffc1"},
		{"id":"45408f7153c1a956","type":"text","text":"Multi-Region (Read Replicas)","x":691,"y":1292,"width":292,"height":59,"color":"#00ffc1"},
		{"id":"ff5836a952229aa3","type":"text","text":"From Single-AZ to Multi-AZ","x":691,"y":1547,"width":284,"height":50,"color":"#00ffc1"},
