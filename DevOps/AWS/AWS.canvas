		{"id":"ef2252eec271dd3e","type":"text","text":"Origin Request","x":-6462,"y":5713,"width":196,"height":50,"color":"#ff006f"},
		{"id":"3c1205ea2a2a1fab","type":"text","text":"Origin Response","x":-6469,"y":5786,"width":203,"height":50,"color":"#ff006f"},
		{"id":"d96b9a296f4a8b7e","type":"text","text":"Viewer Response","x":-6469,"y":5861,"width":210,"height":50,"color":"#ff006f"},
		{"id":"f6ecd974cab5279b","type":"text","text":"When enabled, function is invoked from a pre-initialized state (no function initialization from scratch)","x":-5978,"y":5052,"width":827,"height":50,"color":"#ff006f"},
		{"id":"0ae59713283596a4","type":"text","text":"Improves your Lambda functions performance up to 10x at no extra cost for Java, Python & .NET","x":-5946,"y":4977,"width":795,"height":50,"color":"#ff006f"},
		{"id":"d988c8bd8dc4c5e2","type":"text","text":"A code that you write and attach to CloudFront distributions","x":-5727,"y":5197,"width":530,"height":50,"color":"#ff006f"},
