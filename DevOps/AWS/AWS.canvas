		{"id":"97671d7be5b08433","type":"text","text":"DAX is only used for and is integrated with DynamoDB, while ElastiCache can be used for other databases","x":395,"y":8196,"width":890,"height":56,"color":"#05ffc1"},
		{"id":"b592f7391daa6946","type":"text","text":"It’s OLAP – online analytical processing (analytics and data warehousing)","x":227,"y":8304,"width":639,"height":50,"color":"#05ffc1"},
		{"id":"c492db198b95f389","type":"text","text":"Serverless query service to analyze data stored in Amazon S3","x":319,"y":8481,"width":553,"height":61,"color":"#05ffc1"},
		{"id":"d4cd44c7b87f949a","type":"text","text":"DocumentDB is the same for MongoDB (which is a NoSQL database)","x":281,"y":6771,"width":584,"height":50,"color":"#05ffc1"},
		{"id":"6d91861085a6e900","type":"text","text":"Fully managed, fast, scalable, serverless time series database","x":281,"y":6931,"width":580,"height":50,"color":"#05ffc1"},
		{"id":"4f9dac5aa90f7715","type":"text","text":"Fully managed graph database","x":291,"y":6850,"width":301,"height":50,"color":"#05ffc1"},
		{"id":"d4d3fb4f4638674a","type":"text","text":" recording financial transactions","x":341,"y":7012,"width":338,"height":50,"color":"#05ffc1"},
		{"id":"3ca0805a5670a959","type":"text","text":"Used to review history of all the changes made to your application data over time","x":341,"y":7092,"width":711,"height":50,"color":"#05ffc1"},
		{"id":"a09655737360ced7","type":"text","text":"no decentralization component, in accordance with financial regulation rules","x":341,"y":7172,"width":660,"height":50,"color":"#05ffc1"},
		{"id":"86962e2252b03df9","type":"text","text":"Blockchain makes it possible to build applications where multiple parties can execute transactions without the need for a trusted, central authority.","x":327,"y":7253,"width":845,"height":57,"color":"#05ffc1"},
