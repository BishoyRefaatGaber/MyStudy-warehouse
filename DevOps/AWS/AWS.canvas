		{"id":"c2026b08abdc12ce","type":"text","text":"Get a discount based on long-term usage (up to 72% - same as RIs)","x":2841,"y":-17976,"width":587,"height":50,"color":"3"},
		{"id":"701b9d3b995e71fe","type":"text","text":"Commit to a certain type of usage ($10/hour for 1 or 3 years)","x":2839,"y":-17914,"width":545,"height":50,"color":"3"},
		{"id":"b0d8b0dda3d6d42c","type":"text","text":"Pay for what you use","x":2822,"y":-18794,"width":231,"height":50,"color":"3"},
