		{"id":"cf980294e95b5388","type":"text","text":"User Admin","x":-2495,"y":-916,"width":161,"height":50},
		{"id":"921bb0d74de6d81c","type":"text","text":"Manages app registrations","x":-2860,"y":-841,"width":284,"height":50},
		{"id":"5f54a1fc9c53a781","type":"text","text":"Security Admin","x":-2515,"y":-841,"width":182,"height":50},
		{"id":"dc6a63597fd41402","type":"text","text":"Manage identity & access within Entra ID (Azure AD).","x":-2608,"y":-1113,"width":467,"height":50},
