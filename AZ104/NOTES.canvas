		{"id":"0ce9b34a9a8ad66a","type":"text","text":"Web Application Firewall (WAF)","x":-2320,"y":-2772,"width":300,"height":50},
		{"id":"0d3d779be2667929","type":"text","text":"Manage Identities and Governance","x":-2337,"y":-2117,"width":334,"height":50},
