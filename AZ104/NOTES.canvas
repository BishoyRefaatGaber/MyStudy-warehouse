		{"id":"3d0dbbfa2d22cbaa","type":"text","text":"Azure Container Instance (ACI) “PAAS”","x":1236,"y":-26,"width":360,"height":50},
		{"id":"8e808ce2629a7d48","type":"text","text":"Azure Kubernetes Cluster (AKS) “PAAS”","x":1225,"y":121,"width":383,"height":50},
		{"id":"afe717c948c5d144","type":"text","text":"Azure Container Registry","x":1225,"y":269,"width":255,"height":50},
		{"id":"5611211dfc1f2eb1","type":"text","text":"AKS Cluster Scaling","x":1674,"y":86,"width":250,"height":60},
		{"id":"c989516a467d6c83","type":"text","text":"VPA automatically adjusts CPU and memory requests/limits for pods without changing the number of pods","x":2560,"y":82,"width":868,"height":50},
		{"id":"bab8b57a5cede1a5","type":"text","text":"Vertical Pod Autoscaler (VPA - Resource Scaling for Pods)","x":2008,"y":82,"width":502,"height":50},
		{"id":"a2a0ffd87984baf8","type":"text","text":"HPA automatically scales pods based on CPU, memory, or custom metrics.","x":2472,"y":146,"width":629,"height":50},
		{"id":"30794015ea1bd16b","type":"text","text":"Horizontal Pod Autoscaler (HPA - Pod Scaling)","x":2008,"y":146,"width":414,"height":50},
		{"id":"74de0f8d4f6b3342","type":"text","text":"The Cluster Autoscaler automatically adds or removes nodes based on workload demands.","x":2378,"y":19,"width":772,"height":50},
		{"id":"4e9ee60ebe7bbda5","type":"text","text":" Cluster Autoscaler (Node Scaling)","x":2008,"y":19,"width":320,"height":50},
		{"id":"e28fbec461d6e4a2","type":"text","text":"Application Gateway","x":1528,"y":2043,"width":223,"height":50},
		{"id":"ff6808f999509187","type":"text","text":"a Layer 7 (Application Layer) load balancer designed to manage HTTP/HTTPS traffic.","x":1832,"y":2043,"width":718,"height":50},
		{"id":"a09af6c8d295da95","type":"text","text":"Front Door","x":1528,"y":2118,"width":150,"height":50},
		{"id":"26e50c86f19cde4b","type":"text","text":" Front Door is a global, Layer 7 (HTTP/HTTPS) load balancer","x":1728,"y":2118,"width":525,"height":50},
		{"id":"3cff4e4451495fb9","type":"text","text":"Content Delivery Network (CDN)","x":1528,"y":2192,"width":313,"height":50},
		{"id":"1c34c5e35bd9a055","type":"text","text":"global caching service that accelerates content delivery, improves website performance, and reduces latency by storing cached content in multiple edge locations worldwide.","x":1904,"y":2192,"width":1388,"height":50},
		{"id":"9508293df74191d1","type":"text","text":"Traffic Manager","x":1528,"y":2268,"width":200,"height":50},
		{"id":"3350459d152383d2","type":"text","text":"is a DNS-based global load balancer that directs user requests to the best available endpoint based on traffic-routing methods","x":1796,"y":2268,"width":1029,"height":50},
		{"id":"0d5d2a0239c8851e","type":"text","text":" Unlike a VPN Gateway, which uses the public internet, ExpressRoute provides a secure, high-speed, and low-latency connection over a private network","x":1548,"y":1727,"width":1211,"height":50},
		{"id":"7023d2dc32c23fe1","type":"text","text":"allows two or more Azure Virtual Networks (VNets) to communicate privately over the Azure backbone network.","x":1421,"y":1808,"width":926,"height":50},
		{"id":"23cddb02178c003d","type":"text","text":"Public Load Balancer","x":1832,"y":1888,"width":235,"height":50},
		{"id":"23d34c8670c1275b","type":"text","text":"Hosting public-facing web apps, APIs, or internet services.","x":2113,"y":1888,"width":508,"height":50},
		{"id":"16a08188b8ab1904","type":"text","text":"Azure Load Balancer","x":1528,"y":1933,"width":223,"height":50},
		{"id":"a6aae3ca2e922a8d","type":"text","text":"Internal Load Balancer (Private)","x":1832,"y":1963,"width":310,"height":50},
		{"id":"256b2b992f9a548d","type":"text","text":"Backend applications, database servers, or microservices.","x":2191,"y":1963,"width":506,"height":50},
		{"id":"1408eaebff3d68fc","type":"text","text":"Azure Bastion","x":1221,"y":1481,"width":172,"height":50},
		{"id":"ab9c777321c0fba4","type":"text","text":"Azure VPN Gateway ","x":1221,"y":1585,"width":227,"height":50},
		{"id":"f135271ffbbf3741","type":"text","text":"Azure ExpressRoute ","x":1221,"y":1677,"width":227,"height":50},
		{"id":"1c2094e5f1db45e5","type":"text","text":"Peering","x":1221,"y":1808,"width":128,"height":50},
		{"id":"15fa95bb4b8cb9fc","type":"text","text":"Load Balancers ","x":1221,"y":2088,"width":197,"height":50},
		{"id":"e3d6951ab7235758","type":"text","text":"fully managed PaaS (Platform-as-a-Service)","x":1471,"y":1438,"width":400,"height":50},
		{"id":"0113be6cd7cb1f39","type":"text","text":"provides secure RDP and SSH access to Azure Virtual Machines (VMs) without exposing them to the internet.","x":1471,"y":1506,"width":891,"height":50},
		{"id":"510ea803d513adb8","type":"text","text":"managed network service that provides secure connectivity between on-premises networks and Azure Virtual Networks (VNets) over the public internet using IPsec/IKE (VPN protocols).","x":1526,"y":1585,"width":1479,"height":50},
		{"id":"9aae9bbe92f030fa","type":"text","text":"Azure ExpressRoute is a private, dedicated connection between on-premises networks and Azure data centers.","x":1548,"y":1652,"width":916,"height":50},
		{"id":"dd37376c5d234747","type":"text","text":"Can be assigned to any Azure resource","x":1956,"y":1154,"width":368,"height":50},
		{"id":"2227365bac1b2538","type":"text","text":"Can be Static or Dynamic ","x":1956,"y":1216,"width":266,"height":50},
		{"id":"327dc5dcac88afa4","type":"text","text":" Can only be Static","x":1985,"y":1287,"width":209,"height":50},
		{"id":"65134b25a06040d3","type":"text","text":" Recommended for production workloads.","x":1985,"y":1359,"width":383,"height":50},
		{"id":"6be7122acd7cb873","type":"text","text":"High Availability (HA)","x":2006,"y":955,"width":224,"height":50},
		{"id":"3981ad7151baa561","type":"text","text":"Performance & Scalability","x":2006,"y":1009,"width":265,"height":50},
		{"id":"635b3b78dfd11696","type":"text","text":"Cost Considerations","x":2006,"y":1068,"width":222,"height":50},
		{"id":"d13fa10c01f9838a","type":"text","text":"Deploy NVAs in Active-Active or Active-Passive mode with Azure Load Balancer.","x":2276,"y":954,"width":679,"height":50},
		{"id":"ab142a78e0a2aa39","type":"text","text":"NVAs require third-party licensing, which can be more expensive than Azure Firewall.","x":2288,"y":1068,"width":715,"height":50},
		{"id":"a5e405c0ef958e80","type":"text","text":"Choose VM sizes that match traffic load and enable Autoscaling where available.","x":2324,"y":1009,"width":679,"height":50},
