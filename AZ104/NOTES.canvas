		{"id":"198f0fbd9fe1035e","type":"text","text":"Scope: Azure resources (VMs, Storage, etc.)","x":-2730,"y":-1390,"width":408,"height":50},
		{"id":"7b5f2641b7d0752e","type":"text","text":"Contributor","x":-2685,"y":-1256,"width":170,"height":50},
		{"id":"8c8b0a2506a7136d","type":"text","text":"Owner","x":-2642,"y":-1319,"width":127,"height":50},
