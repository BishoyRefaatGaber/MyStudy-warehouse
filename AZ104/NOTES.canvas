		{"id":"1f4a55b10e599e62","type":"text","text":"stops large-scale network attacks before they reach your app.","x":-2884,"y":-2839,"width":549,"height":50},
		{"id":"5f1ea7f272e43514","type":"text","text":"filters malicious web requests that bypass DDoS protection.","x":-2884,"y":-2772,"width":522,"height":50},
