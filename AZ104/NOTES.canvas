		{"id":"43691fa12c067c8c","type":"text","text":"Highest performance","x":2185,"y":-1115,"width":250,"height":50},
		{"id":"6f727593a9c93d22","type":"text","text":"Most cost-effective storage on HDD","x":2216,"y":-1406,"width":347,"height":50},
		{"id":"4045ce2b8a708c5e","type":"text","text":"Entry level SSD with lowest GiB cost on Cloud","x":2216,"y":-1332,"width":411,"height":50},
		{"id":"43fb375dbdb97b0f","type":"text","text":"Great balance for cost and performance","x":2223,"y":-1262,"width":378,"height":50},
		{"id":"f215109c404c691b","type":"text","text":"Best price performance","x":2223,"y":-1185,"width":250,"height":50},
		{"id":"1376fe767c8445fa","type":"text","text":"The only two types available for root disk in VM","x":2708,"y":-1382,"width":428,"height":50},
		{"id":"8a0bf9eae67db52d","type":"text","text":"Maintaining High Availability","x":1686,"y":-813,"width":276,"height":50},
		{"id":"46e62766e272b8a5","type":"text","text":"Availability Set \n\"Same Availability zone\"","x":2058,"y":-967,"width":250,"height":60},
		{"id":"7e32ee93eb50f4df","type":"text","text":"protect against failures within a single datacenter.","x":2405,"y":-1039,"width":443,"height":50},
		{"id":"36797620d45248e2","type":"text","text":"VMs distributed across:\n- Fault Domains (FDs): different physical racks in the data center\n- Update Domains (UDs): different groups for scheduled maintenance updates.","x":2405,"y":-971,"width":679,"height":127},
		{"id":"6645f22145f13148","type":"text","text":"Availability Zone\n“Same Region Different Availability Zones”","x":2051,"y":-783,"width":384,"height":62},
		{"id":"47b7acb2d9fee962","type":"text","text":"resources are distributed across multiple datacenters (Zones) to improve availability.","x":2520,"y":-768,"width":725,"height":50},
		{"id":"fe29bdba629b3ddf","type":"text","text":" protect against datacenter failures within a region.","x":2520,"y":-833,"width":449,"height":50},
		{"id":"4a284c7267516728","type":"text","text":"Scale Set","x":2051,"y":-686,"width":150,"height":50},
