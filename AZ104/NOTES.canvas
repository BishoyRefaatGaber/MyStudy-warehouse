{
	"nodes":[
		{"id":"00066292b32fd4e4","type":"text","text":"# AZ 104","x":-115,"y":70,"width":165,"height":61},
		{"id":"55cfcbe404bba9ff","type":"text","text":"Resource Structure","x":683,"y":-1943,"width":215,"height":50},
		{"id":"c10b7fb413a9e63e","type":"text","text":"Management groups","x":1040,"y":-2147,"width":220,"height":50},
		{"id":"99bbb511bb78cb92","type":"text","text":" manage access, policy, and compliance for multiple subscriptions.","x":1341,"y":-2197,"width":568,"height":50},
		{"id":"bbc7457bf48529d0","type":"text","text":"All subscriptions in amanagement group automatically inherit the conditions applied to the management group.","x":1341,"y":-2122,"width":903,"height":50},
		{"id":"1cc80fba7d004607","type":"text","text":"logically associate user accounts with the resources they create","x":1289,"y":-2043,"width":551,"height":50},
		{"id":"f7078252fab3bd66","type":"text","text":"Each subscription has limits or quotas on the number of resources it can create and use.","x":1289,"y":-1976,"width":732,"height":50},
		{"id":"17ab8dabf9d5ae10","type":"text","text":"Organizations can use subscriptions to manage costs and the resources created by users, teams, and projects.","x":1289,"y":-1911,"width":908,"height":50},
		{"id":"8db54f0fdd68faa0","type":"text","text":"Subscriptions","x":1040,"y":-1976,"width":171,"height":50},
		{"id":"5ced57640ccab384","type":"text","text":" logical containers where you can deploy and manage Azure resources like virtual machines, web apps, databases, and storage accounts.","x":1282,"y":-1829,"width":1098,"height":50},
