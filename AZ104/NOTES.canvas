		{"id":"c5a793d62725eae9","type":"text","text":"a third-party virtual appliance that provides advanced networking and security capabilities within VNet","x":1629,"y":810,"width":842,"height":50},
		{"id":"7a23e333c990fcda","type":"text","text":"typically used for firewalling, traffic inspection, VPN, load balancing, and WAN optimization.","x":1629,"y":880,"width":754,"height":50},
