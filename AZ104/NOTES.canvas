		{"id":"63f9bf11193372ee","type":"text","text":"Hybrid Users","x":-3173,"y":-2301,"width":164,"height":50},
		{"id":"e7e375e57b38d67d","type":"text","text":"Users from outside the organization (partners, vendors, contractors).","x":-3878,"y":-2488,"width":597,"height":50},
		{"id":"d13bc3b273422aa7","type":"text","text":" Can use Single Sign-On (SSO) across both on-prem & cloud services.","x":-3877,"y":-2276,"width":596,"height":50},
		{"id":"bc3b71ff21fc4b46","type":"text","text":"Users synced from on-prem Active Directory via Entra Connect.","x":-3841,"y":-2351,"width":560,"height":50},
		{"id":"d65f36ca7fc7e637","type":"text","text":"Managed through B2B (Business-to-Business) collaboration.","x":-3802,"y":-2418,"width":521,"height":50},
		{"id":"ac5bbd63a02e6fe8","type":"text","text":"Default users created within the organization.","x":-3691,"y":-2557,"width":410,"height":50},
		{"id":"c572c96928cc1e9e","type":"text","text":"Used to control access to resources","x":-3680,"y":-2207,"width":339,"height":50},
		{"id":"ad894639a1d81463","type":"text","text":"Can include users, devices, and other groups.","x":-3767,"y":-2142,"width":426,"height":50},
